@{
    ViewData["title"] = "اشخاص";
    ViewData["account-tab"] = "active";
    ViewData["accountindex"] = "active";
}
@section Styles {
    <link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
}
<div class="row row-deck row-cards">
    <div class="">
        <div class="card">
            <div class="card-header h2">
                د اشخاصو حسابونه
            </div>
            <div class="card-body">
                <button class="btn btn-primary mb-3" id="createNewPersonAccountBtn">
                    نوی شخص
                    <i class="fas fa-plus ms-3"></i>
                </button>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>نوم</th>
                            <th>کوډ</th>
                            <th>تذکره</th>
                            <th>لومړی شمېره</th>
                            <th>دوهم شمېره</th>
                            <th>ایمیل</th>
                            <th>ادرس</th>
                            <th>حساب ډول</th>
                            <th>فعالیت</th>
                            <th>کړني</th>
                        </tr>
                    </thead>
                    <tbody id="load-people-accounts-list">
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="createNewPersonAccount" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="newPersonAccountForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی شخص</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header">
                <h3 class="h3">د شخص معلومات</h3>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-name">نوم</label>
                            <input type="text" class="form-control" id="new-name" placeholder="نوم" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-code">کوډ</label>
                            <input type="text" class="form-control" id="new-code" placeholder="کوډ، مثلاً: ACC001" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-tazkira">تذکره</label>
                            <input type="text" class="form-control" id="new-tazkira" placeholder="تذکره" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-first-phone">لومړی شمېره</label>
                            <input type="text" class="form-control" id="new-first-phone" placeholder="لومړی شمېره" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-second-phone">دوهم شمېره</label>
                            <input type="text" class="form-control" id="new-second-phone" placeholder="دوهم شمېره" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-email">ایمېل</label>
                            <input type="text" class="form-control" id="new-email" placeholder="ایمېل" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-address">آدرس</label>
                            <input type="text" class="form-control" id="new-address" placeholder="آدرس" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-person-type">حساب ډول</label>
                            <select id="new-person-type" class="form-control" placeholder="شخص ډول"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-header">
                <h3 class="h3">د شخص بلانسونه</h3>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th class="d-none">#</th>
                            <th>بلانس ډول</th>
                            <th>مقدار</th>
                        </tr>
                    </thead>
                    <tbody id="listCurrencies">
                        <!-- Balance rows will be populated here -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" id="btnSaveNewPersonAccount" type="submit">
                    ثبت
                    <i class="fas fa-save ms-2"></i>
                </button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">
                    لغوه
                    <i class="fas fa-times ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
    <script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>

    <script>
        $("#createNewPersonAccountBtn").click(function(){
            $.ajax({
                url: "/api/Accounts/NextCode",
                type: "GET",
                success: function(data){
                    $("#new-code").val(data);
                },
                error : function(response){
                    showToast("warning", response.responseText);
                }
            });
            $("#createNewPersonAccount").modal('show');
        });
    </script>
    
    <script>
        var ts = new TomSelect("#new-person-type", {
            valueField: "id",
            labelField: "name",
            searchField: "name"
        });
        $.get("/api/Accounts/GetPeopleAccountTypes", function(data) {
            ts.addOptions(data);
            ts.refreshOptions(false);
        });

        $.ajax({
            url: "/api/Currency/Currencies/Simple",
            type: "GET",
            success: function(data) {
                var listCurrencies = $("#listCurrencies");
                data.forEach(function(currency) {
                    var row = $("<tr>");
                    row.append($("<td>").addClass("d-none").text(currency.id));
                    row.append($("<td>").text(currency.name));
                    row.append($("<td>").append($("<input>").attr("type", "number").attr("step", "any").attr("value", "0").addClass("form-control new-person-balance-validator").attr("placeholder", "مقدار")));
                    listCurrencies.append(row);
                });
            },
        });

        var newPersonAccountFormValidator = new JustValidate("#newPersonAccountForm");
        newPersonAccountFormValidator
        .addField("#new-name", [
            {
                rule: "required",
                errorMessage: "نوم اړین دی"
            }
        ])
        .addField("#new-code", [
            {
                rule: "required",
                errorMessage: "کوډ اړین دی"
            }
        ])
        .addField("#new-first-phone", [
            {
                rule: "required",
                errorMessage: "لومړی موبایل نمبر اړین دی"
            }
        ])
        .addField("#new-person-type", [
            {
                rule: "required",
                errorMessage: "حساب ډول اړین دی"
            }
        ]);
        newPersonAccountFormValidator.onSuccess(function(event) {
            event.preventDefault();
            var formData = {
                name: $("#new-name").val(),
                code: $("#new-code").val(),
                nic: $("#new-tazkira").val(),
                firstPhone: $("#new-first-phone").val(),
                secondPhone: $("#new-second-phone").val(),
                email: $("#new-email").val(),
                address: $("#new-address").val(),
                accountTypeId: ts.getValue(),
                balance: []
            };
            $("#listCurrencies tr").each(function() {
                var currencyId = $(this).find("td:first").text();
                var amount = $(this).find("input").val();
                if (amount) {
                    formData.balance.push({ currencyID: currencyId, balance: parseFloat(amount) });
                }
            });
            console.log(JSON.stringify(formData));
            $.ajax({
                url: "/api/Accounts/CreatePersonAccount",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function(response) {
                    showToast("شخص حساب په بریالیتوب سره جوړ سو!");
                    $("#newPersonAccountForm")[0].reset();
                    $("#createNewPersonAccount").modal("hide");
                    loadPeoplAccountList();
                },
                error: function(xhr, status, error) {
                    showToast("د شخص حساب جوړولو کې ستونزه رامنځته شوه.");
                }
            });
        });

        // load people list 
        loadPeoplAccountList();
        function loadPeoplAccountList(){
            $.ajax({
                url : "/api/Accounts/PeopleAccount",
                type : "GET",
                success: function (data) {
                    var dataTable = $("#load-people-accounts-list");
                    dataTable.empty();

                    data.forEach(function (rows) {
                        var row = $("<tr>");

                        $("<td>").text(rows.id).appendTo(row);
                        $("<td>").text(rows.name).appendTo(row);
                        $("<td>").text(rows.code).appendTo(row);
                        $("<td>").text(rows.nic).appendTo(row);
                        $("<td>").text(rows.firstPhone).appendTo(row);
                        $("<td>").text(rows.secondPhone).appendTo(row);
                        $("<td>").text(rows.email).appendTo(row);
                        $("<td>").text(rows.address).appendTo(row);
                        $("<td>").text(rows.accountTypeName).appendTo(row);
                        $("<td>").text(rows.isActive ? "فعال" : "غیر فعال").appendTo(row);

                        var actions = $("<td>");
                        var buttonGroup = $("<div>").addClass("btn-group");

                        $("<button>")
                            .text("تغیر")
                            .addClass("btn btn-sm btn-primary")
                            .attr("data-id", rows.id)
                            .appendTo(buttonGroup);

                        $("<button>")
                            .text("بلانس")
                            .addClass("btn btn-sm btn-primary")
                            .attr("data-id", rows.id)
                            .appendTo(buttonGroup);

                        $("<button>")
                            .text(rows.isActive ? "غیر فعال" : "فعال")
                            .addClass(rows.isActive ? "btn btn-sm btn-danger" : "btn btn-sm btn-success")
                            .attr("data-id", rows.id)
                            .appendTo(buttonGroup);

                        actions.append(buttonGroup);
                        row.append(actions);
                        dataTable.append(row);
                    });
                },
                error : function(response){
                    showToast("warning", response.responseText);
                }
            });
        }
    </script>
}