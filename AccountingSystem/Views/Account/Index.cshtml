@{
    ViewData["title"] = "اشخاص";
    ViewData["account-tab"] = "active";
    ViewData["accountindex"] = "active";
}
@section Styles {
    <link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
}
<div class="row row-deck row-cards">
    <div class="">
        <div class="card">
            <div class="card-header h2">
                د اشخاصو حسابونه
            </div>
            <div class="card-body">
                <button class="btn btn-primary mb-3" id="createNewPersonAccountBtn">
                    نوی شخص
                    <i class="fas fa-plus ms-3"></i>
                </button>
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>نوم</th>
                            <th>کوډ</th>
                            <th>تذکره</th>
                            <th>لومړی شمېره</th>
                            <th>دوهم شمېره</th>
                            <th>ایمیل</th>
                            <th>ادرس</th>
                            <th>حساب ډول</th>
                            <th>فعالیت</th>
                            <th style="width: 100px;">کړني</th>
                        </tr>
                    </thead>
                    <tbody id="load-people-accounts-list">
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* start of new account form/modal *@
<div class="modal fade" id="createNewPersonAccount" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="newPersonAccountForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی شخص</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header">
                <h3 class="h3">د شخص معلومات</h3>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-name">نوم</label>
                            <input type="text" class="form-control" id="new-name" placeholder="نوم" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-code">کوډ</label>
                            <input type="text" class="form-control" id="new-code" placeholder="کوډ، مثلاً: ACC001" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-tazkira">تذکره</label>
                            <input type="text" class="form-control" id="new-tazkira" placeholder="تذکره" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-first-phone">لومړی شمېره</label>
                            <input type="text" class="form-control" id="new-first-phone" placeholder="لومړی شمېره" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-second-phone">دوهم شمېره</label>
                            <input type="text" class="form-control" id="new-second-phone" placeholder="دوهم شمېره" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-email">ایمېل</label>
                            <input type="text" class="form-control" id="new-email" placeholder="ایمېل" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-address">آدرس</label>
                            <input type="text" class="form-control" id="new-address" placeholder="آدرس" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-person-type">حساب ډول</label>
                            <select id="new-person-type" class="form-control" placeholder="شخص ډول"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-header">
                <h3 class="h3">د شخص بلانسونه</h3>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th class="d-none">#</th>
                            <th>اسعارو نوم</th>
                            <th>مقدار</th>
                        </tr>
                    </thead>
                    <tbody id="listCurrencies">
                        <!-- Balance rows will be populated here -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" id="btnSaveNewPersonAccount" type="submit">
                    ثبت
                    <i class="fas fa-save ms-2"></i>
                </button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">
                    لغوه
                    <i class="fas fa-times ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>
@* end of new account form/modal *@

@* start of edit person account form/modal *@
