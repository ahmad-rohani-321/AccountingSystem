@{
    ViewData["title"] = "اداري حسابونه";
    ViewData["account-tab"] = "active";
    ViewData["accountaccounts"] = "active";
}

@section Styles {
    <link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
}
<div class="row row-deck row-cards">
    <div class="">
        <div class="card">
            <div class="card-header h2">
                @ViewData["title"]
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <button class="btn btn-primary" id="createNewAccountBtn">
                    نوی حساب
                    <i class="fas fa-plus ms-3"></i>
                    </button>
                </div>
                <table class="table table-bordered table-hover table-responsive table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>نوم</th>
                            <th>کوډ</th>
                            <th>حساب ډول</th>
                            <th>فعالیت</th>
                            <th style="width: 100px;">کړني</th>
                        </tr>
                    </thead>
                    <tbody id="load-accounts-list">
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* start of new account form/modal *@
<div class="modal fade" id="createNewAccount" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="newAccountForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی حساب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header">
                <h3 class="h3">د حساب معلومات</h3>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-name">نوم</label>
                            <input type="text" class="form-control" id="new-name" placeholder="نوم" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-code">کوډ</label>
                            <input type="text" class="form-control" id="new-code" placeholder="کوډ، مثلاً: ACC001" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="new-account-type">حساب ډول</label>
                            <select id="new-account-type" class="form-control" placeholder="حساب ډول"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-header">
                <h3 class="h3">د حساب بلانسونه</h3>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th class="d-none">#</th>
                            <th>اسعارو نوم</th>
                            <th>مبلغ</th>
                        </tr>
                    </thead>
                    <tbody id="listCurrencies">
                        <!-- Balance rows will be populated here -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" type="submit">
                    ثبت
                    <i class="fas fa-save ms-2"></i>
                </button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">
                    لغوه
                    <i class="fas fa-times ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>
@* end of new account form/modal *@

@* start of edit person account form/modal *@
<div class="modal fade" id="editAccount" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="editAccountForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی حساب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header">
                <h3 class="h3">د حساب معلومات</h3>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-account-id" />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="edit-name">نوم</label>
                            <input type="text" class="form-control" id="edit-name" placeholder="نوم" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="edit-code">کوډ</label>
                            <input type="text" class="form-control" id="edit-code" placeholder="کوډ، مثلاً: ACC001" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="edit-account-type">حساب ډول</label>
                            <select id="edit-account-type" class="form-control" placeholder="حساب ډول"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" type="submit">
                    ثبت
                    <i class="fas fa-save ms-2"></i>
                </button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">
                    لغوه
                    <i class="fas fa-times ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>
@* end of edit person account form/modal *@


@* start of account balance *@
<div class="modal fade" id="balancesModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی حساب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header">
                <h3 class="h3">د حساب معلومات <span Id="new-account-name" class="text-primary"></span></h3>
            </div>
            <div class="modal-body">
                <h3 class="h3">د حساب بلانسونه</h3>
                <table class="table table-bordered table-hover table-striped">
                    <thead>
                        <tr>
                            <th>اسعار</th>
                            <th>مقدار</th>
                        </tr>
                    </thead>
                    <tbody id="balances">
                        <!-- Balance rows will be populated here -->
                    </tbody>
                </table>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">
                    لغوه
                    <i class="fas fa-times ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>
@* end of account balance *@

@section Scripts {
<script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>

<script>
$(document).ready(function() {
    // show new person account modal
    $("#createNewAccountBtn").click(function(){
        $.ajax({
            url: "/api/Accounts/NextCode",
            type: "GET",
            success: function(data){
                $("#new-code").val(data);
            },
            error : function(response){
                showToast("warning", response.responseText);
            }
        });
        $("#createNewAccount").modal('show');
    });


    var ts = new TomSelect("#new-account-type", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
    
    var edit_ts = new TomSelect("#edit-account-type", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
    // load account types 
        $.get("/api/Accounts/GetTreasureAccountTypes", function(data) {
        ts.addOptions(data);
        ts.refreshOptions(false);

        edit_ts.addOptions(data);
        edit_ts.refreshOptions(false);
    });
    // load currencies 
    $.ajax({
        url: "/api/Currency/Currencies/Simple",
        type: "GET",
        success: function(data) {
            var listCurrencies = $("#listCurrencies");
            data.forEach(function(currency) {
                var row = $("<tr>");
                row.append($("<td>").addClass("d-none").text(currency.id));
                row.append($("<td>").text(currency.name));
                row.append($("<td>").append($("<input>").attr("type", "number").attr("step", "any").attr("value", "0").addClass("form-control new-person-balance-validator").attr("placeholder", "مقدار")));
                listCurrencies.append(row);
            });
        },
    });
    // validate new person account form
    var newPersonAccountFormValidator = new JustValidate("#newAccountForm");
    newPersonAccountFormValidator
    .addField("#new-name", [
        {
            rule: "required",
            errorMessage: "نوم اړین دی"
        }
    ])
    .addField("#new-code", [
        {
            rule: "required",
            errorMessage: "کوډ اړین دی"
        }
    ])
    .addField("#new-account-type", [
        {
            rule: "required",
            errorMessage: "حساب ډول اړین دی"
        }
    ]);
    // submit new person account form 
    newPersonAccountFormValidator.onSuccess(function(event) {
        event.preventDefault();
        var formData = {
            name: $("#new-name").val(),
            code: $("#new-code").val(),
            accountTypeId: ts.getValue(),
            balance: []
        };
        $("#listCurrencies tr").each(function() {
            var currencyId = $(this).find("td:first").text();
            var amount = $(this).find("input").val();
            if (amount) {
                formData.balance.push({ currencyID: currencyId, balance: parseFloat(amount) });
            }
        });
        $.ajax({
            url: "/api/Accounts/CreateAccount",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(formData),
            success: function(response) {
                showToast("success", "شخص حساب په بریالیتوب سره جوړ سو!");
                $("#newAccountForm")[0].reset();
                $("#createNewAccount").modal("hide");
                loadPeoplAccountList();
            },
            error: function(response) {
                showToast("warning", response.responseText);
            }
        });
    });
    $("#newAccountForm").on("reset", function() {
        ts.clear();
    });
    // load people list 
    loadPeoplAccountList();
    function loadPeoplAccountList(){
        $.ajax({
            url : "/api/Accounts/NormalAccounts",
            type : "GET",
            success: function (data) {
                console.log(data);
                var dataTable = $("#load-accounts-list");
                dataTable.empty();
                data.forEach(function (rows) {
                    var row = $("<tr>");

                    $("<td>").text(rows.id).appendTo(row);
                    $("<td>").text(rows.name).appendTo(row);
                    $("<td>").text(rows.code).appendTo(row);
                    $("<td>").text(rows.accountTypeName).appendTo(row);
                    $("<td>").text(rows.isActive ? "فعال" : "غیر فعال").css("width", "100px").appendTo(row);

                    var actions = $("<td>");
                    if(rows.accountTypeId != 10){
                        var buttonGroup = $("<div>").addClass("btn-group");

                        $("<button>")
                            .text("تغیر")
                            .addClass("btn btn-sm btn-primary btn-edit-account")
                            .attr("data-row", JSON.stringify(rows))
                            .appendTo(buttonGroup);

                        $("<button>")
                            .text("بلانس")
                            .addClass("btn btn-sm btn-primary btn-view-account-balance")
                            .attr("data-info", JSON.stringify({ id: rows.id, name: rows.name }))
                            .appendTo(buttonGroup);

                        $("<button>")
                            .text(rows.isActive ? "غیر فعال" : "فعال")
                            .addClass(rows.isActive ? "btn btn-sm btn-danger btn-toggle-account-activation" : "btn btn-sm btn-success btn-toggle-account-activation")
                            .attr("data-id", rows.id)
                            .appendTo(buttonGroup);

                        actions.append(buttonGroup);
                    }
                        row.append(actions);
                        dataTable.append(row);
                    
                });
            },
            error : function(response){
                showToast("warning", response.responseText);
            }
        });
    }
    // validate edit person account form
    var editPersonAccountFormValidator = new JustValidate("#editAccountForm");
    editPersonAccountFormValidator
    .addField("#edit-name", [
        {
            rule: "required",
            errorMessage: "نوم اړین دی"
        }
    ])
    .addField("#edit-code", [
        {
            rule: "required",
            errorMessage: "کوډ اړین دی"
        }
    ])
    .addField("#edit-account-type", [
        {
            rule: "required",
            errorMessage: "حساب ډول اړین دی"
        }
    ]);
    // submit edit person account form
    editPersonAccountFormValidator.onSuccess(function(event) {
        event.preventDefault();
        var formData = {
            id: $("#edit-account-id").val(),
            name: $("#edit-name").val(),
            code: $("#edit-code").val(),
            accountTypeId: edit_ts.getValue()
        };
        $.ajax({
            url: "/api/Accounts/UpdateAccount",
            type: "PUT",
            contentType: "application/json",
            data: JSON.stringify(formData),
            success: function(response) {
                showToast("success", "شخص حساب په بریالیتوب سره تازه سو!");
                $("#editAccountForm")[0].reset();
                $("#editAccount").modal("hide");
                loadPeoplAccountList();
            },
            error: function(xhr, status, error) {
                showToast("warning", "د شخص حساب تازه کولو کې ستونزه رامنځته سوه.");
            }
        });
    });
    // edit person account information
    $(document).on("click", ".btn-edit-account", function(){
        var row = $(this).data("row");
        $("#edit-code").val(row.code);
        $("#edit-name").val(row.name);
        $("#edit-account-id").val(row.id);
        
        
        const tom = $("#edit-account-type")[0].tomselect;
        tom.setValue(row.accountTypeId);

        $("#editAccount").modal("show");
    });
    // view person account balance
    $(document).on("click", ".btn-view-account-balance", function(){
        var info = $(this).data("info");
        $.ajax({
            url: "/api/Accounts/GetAccountBalance/" + info.id,
            type: "GET",
            success: function(response) {
                $("#new-account-name").text(info.name);
                var personBalances = $("#balances");
                personBalances.empty();
                response.forEach(function(balance) {
                    var row = $("<tr>");
                    row.append($("<td>").text(balance.currencyName));
                    row.append($("<td>").text(balance.balance));
                    personBalances.append(row);
                });
                $("#balancesModal").modal("show");
            },
            error: function(xhr, status, error) {
                showToast("warning", "د حساب بیلانس وچولو کې ستونزه رامنځته سوه.");
            }
        });
    });
    // change account activation
    $(document).on("click", ".btn-toggle-account-activation", function(){
        var id = $(this).data("id");

            sweetAlert("تاسو اطمناني یاست؟", "تاسو اطمناني یاست، ترڅو انتخاب سوي حساب غیر فعال کړئ؟")
            .then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/api/Accounts/UpdateAccountActivation/" + id,   // Your API endpoint
                        type: "PUT",

                        success: function (response) {

                            showToast("success", "د انتخاب سوي حساب فعالیت تغیر کړل سو.");

                            loadPeoplAccountList();
                        },

                        error: function (responsive) {
                            showToast("warning", responsive.responseText);
                        }
                    });

                }

            });
    });
});
</script>
}