@section Scripts{
<script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
@* start of unit code *@
<script>
function generalContentLoader(endpointName, tbodyId, editButtonClass, changeActivationClass){
    $.ajax({
        url : "/api/Inventory/" + endpointName,
        type : "GET",
        success : function(response){
            var tableData = $(tbodyId);
            tableData.empty();
            
            response.forEach(function (data){
                var row = $("<tr>");
                $("<td>").text(data.id).appendTo(row);
                $("<td>").text(data.name).appendTo(row);
                $("<td>").text(data.description).appendTo(row);
                $("<td>").text(data.isActive ? "فعال" : "غیر فعال").appendTo(row);

                var actions = $("<td>");
                var buttonGroup = $("<div>").addClass("btn-group");
                $("<button>")
                    .addClass("btn btn-primary btn-sm " + editButtonClass)
                    .text("تغیر")
                    .attr("data-row", JSON.stringify(data))
                    .appendTo(buttonGroup);

                $("<button>")
                    .addClass(!data.isActive ? ("btn btn-success btn-sm " + changeActivationClass) : ("btn btn-danger btn-sm " + changeActivationClass))
                    .text(!data.isActive ? "فعال" : "غیر فعال")
                    .attr("data-id", data.id)
                    .appendTo(buttonGroup);
                
                buttonGroup.appendTo(actions);
                actions.appendTo(row);
                row.appendTo(tableData);
            });
        },
        error : function(response){
            showToast("warning", response.responseText);
        }
    });
}
function generalContentCreator(formId, nameFieldId, descriptionFieldId, endPointName, createModalId, successMessage, contentLoaderObject){
    var formvalidator = new JustValidate(formId);
        formvalidator.
        addField(nameFieldId, [
        {
            rule : "required",
            errorMessage : "نوم حتمي دی"
        }
        ]);

    formvalidator.onSuccess((event) => {
        event.preventDefault();
        
        var category = {
            name : $(nameFieldId).val(),
            description : $(descriptionFieldId).val()
        };
        $.ajax({
            url  : ("/api/Inventory/" + endPointName),
            type : "POST",
            contentType: "application/json",
            data : JSON.stringify(category),
            success : function(response){
                $(formId)[0].reset();
                $(createModalId).modal("hide");
                showToast("success", successMessage);
                generalContentLoader(contentLoaderObject.endPointName, contentLoaderObject.tbodyId, contentLoaderObject.editButtonClass, contentLoaderObject.changeActivationClass);
            },
            error : function(response){
                showToast("warning", response.responseText);
            }
        });
    });
}
function generalContentUpdater(formId, idFieldId, nameFieldId, descriptionFieldId, endPointName, updateModalId, successMessage, contentLoaderObject){
    var editCatModalValidator = new JustValidate(formId);
        editCatModalValidator.
        addField(nameFieldId, [
        {
            rule : "required",
            errorMessage : "نوم حتمي دی"
        }
        ]);
        editCatModalValidator.onSuccess((event) => {
        event.preventDefault();
        var category = {
            id: $(idFieldId).val(),
            name : $(nameFieldId).val(),
            description : $(descriptionFieldId).val()
        };
        $.ajax({
            url  : ("/api/Inventory/" + endPointName),
            type : "PUT",
            contentType: "application/json",
            data : JSON.stringify(category),
            success : function(response){
                $(formId)[0].reset();
                $(updateModalId).modal("hide");
                showToast("success", successMessage);
                generalContentLoader(contentLoaderObject.endPointName, contentLoaderObject.tbodyId, contentLoaderObject.editButtonClass, contentLoaderObject.changeActivationClass);
            },
            error : function(response){
                showToast("warning", response.responseText);
            }
        });
    });
}
function generalContentActivationChanger(activationClass, modalName, activationModel, contentLoaderObject){
    $(document).on("click", activationClass, function(event){
        var id = $(this).data("id");
        sweetAlert("تاسو اطمناني یاست؟", "تاسو اطمناني یاست، غواړی د " + modalName + " فعالیت تغیر کړی؟")
            .then((result) => {
                if (result.isConfirmed) {

                    $.ajax({
                        url: "/api/Inventory/" + activationModel + "/" + id,  
                        type: "PUT",

                        success: function (response) {

                            showToast("success", "د انتخاب سوي " + modalName + " فعالیت تغیر کړل سو.");

                            generalContentLoader(contentLoaderObject.endPointName, contentLoaderObject.tbodyId, contentLoaderObject.editButtonClass, contentLoaderObject.changeActivationClass);
                        },

                        error: function (responsive) {
                            showToast("warning", responsive.responseText);
                        }
                    });

                }
            });
    });
}
</script>
<script>
var unitContentLoaderObject = {
    endPointName : "GetUnitsList", 
    tbodyId :  "#unitslist", 
    editButtonClass : "btn-edit-unit", 
    changeActivationClass : "btn-change-unit-activation"
}
generalContentLoader(unitContentLoaderObject.endPointName, 
    unitContentLoaderObject.tbodyId, 
    unitContentLoaderObject.editButtonClass, 
    unitContentLoaderObject.changeActivationClass);

generalContentCreator("#new-unit-form", "#unitname", "#unitdescription", "CreateUnit", "#add-unit-modal", "کټیګوری ثبت سو", unitContentLoaderObject);

generalContentUpdater("#edit-unit-form", 
    "#unitId", 
    "#editunitname", 
    "#editunitdescription", 
    "UpdateUnit", 
    "#edit-unit-modal", 
    "واحد تغیر سو", unitContentLoaderObject);
    
$(document).on("click", ".btn-edit-unit", function(event){
    var row = $(this).data("row");
    $("#unitId").val(row.id);
    $("#editunitname").val(row.name);
    $("#editunitdescription").val(row.description);

    $("#edit-unit-modal").modal("show");
});
generalContentActivationChanger(".btn-change-unit-activation", 
    "واحد", 
    "ChangeUnitActivation", 
    unitContentLoaderObject);

    $(document).on("click", ".btn-edit-cat", function(event){
        var row = $(this).data("row");
        $("#catId").val(row.id);
        $("#editcatname").val(row.name);
        $("#editcatdescription").val(row.description);

        $("#edit-cat-modal").modal("show");
    });
</script>
@* end of unit code *@

