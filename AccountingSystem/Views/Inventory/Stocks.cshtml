}

@* start of stock code *@
<div class="row row-deck row-cards">
    <div class="card">
        <div class="card-header">
            <h3 class="h3">@ViewData["title"]</h3>
        </div>
        <div class="card-body">
            <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#add-stock-modal">نوی ګدام
                <i class="fas fa-plus ms-3"></i>
            </button>
            <table class="table table-hover table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>نوم</th>
                        <th>تشریح</th>
                        <th>فعالیت</th>
                        <th>کړني</th>
                    </tr>
                </thead>
                <tbody id="stocksList">
                    
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="add-stock-modal" tabindex="-1">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <form id="new-stock-form">
                <div class="modal-body py-4">
                    <h2>نوي ګدام</h2>
                    <div class="mb-3">
                        <label class="form-label" for="stockname">ګدام نوم</label>
                        <input type="text" class="form-control" id="stockname" name="newStockName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="stockdescription">تشریح</label>
                        <input type="text" class="form-control" id="stockdescription" name="newStockDescription" />
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <button id="save-new-stock" type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

