    newStockValidator.addField(unitsField[0], [
        {
            rule: "required",
            errorMessage: "واحد اړین دی"
        }
    ]);

    newStockValidator.addField(stockField[0], [
        {
            rule: "required",
            errorMessage: "ګدام اړین دی"
        }
    ]);

    newStockValidator.addField(quantityField[0], [
        {
            rule: "required",
            errorMessage: "تعداد اړین دی"
        },
        {
            validator: function(value) {
                return Number(value) > 0;
            },
            errorMessage: "تعداد باید له صفر څخه زیات وي"
        }
    ]);

});

newStockValidator.onSuccess(function(event){
    if(!event){
        return;
    }
    event.preventDefault();
    var id = $("#newStockItemId").val();
    const item = {
        unitConversions: $("#newStockRows tr").map(function (){
            const cells = $(this).find("td");

            return {
                itemId: id,
                unitId: Number(cells.eq(0).find("select").val()),
                quantity: Number(cells.eq(1).find("input").val() || 0),
                stockId: Number(cells.eq(2).find("select").val()),
                baseCurrencyPurchasePrice: Number(cells.eq(3).find("input").val() || 0),
                remarks: cells.eq(4).find("input").val()
            };
        }).get()
    };
    
    $.ajax({
        url: "/api/Inventory/NewItemStockEntry",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(item.unitConversions),
        success : function(response){
            showToast("success", "ثبت سو.");
            $("#newStockForm")[0].reset();
            $("#newStock").modal("hide");
                },
        error : function(error){
            showToast("warning", error.responseText);
        }
    });
});

$("#newStockForm").on("reset", function(event){
    setTimeout(function(){
        $("#newStockRows tr").each(function(){
            var row = $(this);

            newStockValidator.removeField(row.find('.form-control-unit')[0]);
            newStockValidator.removeField(row.find('.form-control-quantity')[0]);
            newStockValidator.removeField(row.find('.form-control-stock')[0]);
        });
        newStockValidator.clearErrors();
        $("#newStockRows").empty();
    });
});

$(document).on("click", ".btn-remove-row", function (event) {
    event.preventDefault();
    var row = $(this).closest("tr");
    newStockValidator.removeField(row.find('.form-control-unit')[0]);
    newStockValidator.removeField(row.find('.form-control-quantity')[0]);
    newStockValidator.removeField(row.find('.form-control-stock')[0]);
    row.remove();
});

function getItemsList(){
    $.ajax({
        url: "/api/Inventory/GetItemsList",
        type: "GET",
        success : function(respondedData){
            var dataTable = $("#itemsList");
            dataTable.empty();
            respondedData.forEach(function(data){
                var tr = $("<tr>");
                $("<td>").text(data.id).appendTo(tr);
                var imageCell = $("<td>");
                var imageThumb = $("<img>").addClass("item-image").attr("src", "Items/"+ data.image);
                imageThumb.appendTo(imageCell);
                imageCell.appendTo(tr);
                $("<td>").text(data.name).appendTo(tr);
                $("<td>").text(data.secondName).appendTo(tr);
                $("<td>").text(data.code).appendTo(tr);
                $("<td>").text(data.serialNo).appendTo(tr);
                $("<td>").text(data.description).appendTo(tr);
                var activation = $("<td>").appendTo(tr);
                $("<span>").addClass(data.isActive ? "badge bg-blue text-blue-fg" : "badge bg-red text-red-fg").text(data.isActive ? "فعال" : "غیر فعال").appendTo(activation);
                $("<td>").text(data.minQuantity).appendTo(tr);
                $("<td>").text(data.categoryName).appendTo(tr);
                $("<td>").text(data.mainUnitName).appendTo(tr);
                var actionsCell = $("<td>");
                var dropDown = $("<div>").addClass("btn-group");
                
                $("<button>").addClass("btn btn-primary btn-edit").attr("data-row", JSON.stringify(data)).text("تغیر").appendTo(dropDown);

                var drowDownToggle = $("<button>").addClass("btn btn-primary dropdown-toggle dropdown-toggle-split").attr("data-bs-toggle", "dropdown").attr("aria-expanded", "false").appendTo(dropDown);

                $("<span>").addClass("visually-hidden").appendTo(dropDown);

                var ul = $("<ul>").addClass("dropdown-menu");

                var firstUl = $("<li>");
                $("<button>").addClass(data.isActive ? "dropdown-item btn-change-activation" : "dropdown-item btn-change-activation").text(data.isActive ? "غیر فعال" : "فعال").attr("data-id", data.id).appendTo(firstUl);
                firstUl.appendTo(ul);

                var secondUl = $("<li>");
                $("<button>").addClass("dropdown-item btn-new-stock").attr("data-nameandsecondname", JSON.stringify({id : data.id, name : data.name, secondName : data.secondName})).text("ابتدایی موجودي").appendTo(secondUl);
                secondUl.appendTo(ul);
                
                ul.appendTo(dropDown);
                dropDown.appendTo(actionsCell);
                actionsCell.appendTo(tr);
                tr.appendTo(dataTable);

            });
        },
        error : function(error){
            console.error(error);
        }
    });
}
</script>
