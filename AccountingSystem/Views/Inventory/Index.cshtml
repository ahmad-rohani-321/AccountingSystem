@{
    ViewData["title"] = "اجناس";
    ViewData["Inventory"] = "active";
    ViewData["Items"] = "active";
}
@section Styles {
    <link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
    <style>
        .item-image {
            width: 90px;
        }
    </style>
}
<div class="row row-deck row-cards">
    <div class="card">
        <div class="card-header">
            <h3 class="h3">@ViewData["title"]</h3>
        </div>
        <div class="card-body">
            <button class="btn btn-primary mb-3" id="createNewItem">
                نوی جنس
                <i class="fas fa-plus ms-3"></i>
            </button>
            <table class="table table-hover table-bordered table-responsive table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>عکس</th>
                        <th>نوم</th>
                        <th>دوهم نوم</th>
                        <th>جنس کوډ</th>
                        <th>سیریل نمبر</th>
                        <th>تشریح</th>
                        <th>فعالیت</th>
                        <th>د کمښت خبرتیا</th>
                        <th>کټیګوري</th>
                        <th>عمومي واحد</th>
                        <th>کړني</th>
                    </tr>
                </thead>
                <tbody id="itemsList">
                </tbody>
            </table>
        </div>
    </div>
</div>

@* start of create new Item modal *@
<div class="modal fade" id="createItemModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h2>نوی جنس</h2>
            </div>
            <form id="createItemForm">
                <div class="modal-body py-4">
                    <h3 class="h3">جنس معلومات</h3>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newName">جنس نوم</label>
                                <input type="text" class="form-control" id="newName" />
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newSecondName">دوهم نوم</label>
                                <input type="text" class="form-control" id="newSecondName" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newItemCode">جنس کوډ</label>
                                <input type="text" class="form-control" id="newItemCode" />
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newSerialNo">سیریل نمبر</label>
                                <input type="text" class="form-control" id="newSerialNo" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newDescription">تشریح</label>
                                <input type="text" class="form-control" id="newDescription" />
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newMinItems">د کمښت خبرتیا</label>
                                <input type="number" class="form-control" id="newMinItems" value="0" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newCategory"> کټیګوري</label>
                                <select class="form-control" id="newCategory"></select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newUnit">عمومي واحد</label>
                                <select class="form-control" id="newUnit"></select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="newCategory"> کټیګوري</label>
                                <input type="file" class="form-control" id="newImage" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-body py-4">
                    <h3 class="h3">فرعي واحدونه</h3>
                    <table class="table table-bordered table-responsive table-hover table-striped">
                        <thead>
                            <tr>
                                <th class="d-none">#</th>
                                <th>واحد</th>
                                <th>عمومي واحد اندازه</th>
                                <th>فرعي واحد اندازه</th>
                                <th>ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody id="newSubUnits"></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <button id="save-edited-unit" type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@* end of create new Item modal *@

