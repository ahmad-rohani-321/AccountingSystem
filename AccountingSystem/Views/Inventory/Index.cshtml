@section Scripts{
<script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
<script>
$(document).ready(function(){
    getItemsList();
});

$.ajax({
    url: "/api/Inventory/GetActiveUnitsList",
    type : "GET",
    success : function(data){
        var dataTable = $("#newSubUnits");
        data.forEach(function(eachRow){
            var tr = $("<tr>");
            $("<td>").addClass("d-none").text(eachRow.id).appendTo(tr);
            $("<td>").text(eachRow.name).appendTo(tr);

            var mainUnit = $("<td>");
            var mainUnitControl = $("<input>").attr("type", "number").attr("value", "0").addClass("form-control");
            mainUnitControl.appendTo(mainUnit);
            mainUnit.appendTo(tr);

            var subUnit = $("<td>");
            var subUnitControl = $("<input>").attr("type", "number").attr("value", "0").addClass("form-control");
            subUnitControl.appendTo(subUnit);
            subUnit.appendTo(tr);

            var remarkTd = $("<td>");
            var remarksControl = $("<input>").attr("type", "text").addClass("form-control");
            remarksControl.appendTo(remarkTd);
            remarkTd.appendTo(tr);

            createItemFormValidator.addField(mainUnitControl[0], [
            {
                validator: function(value){
                    return (value == 0 && subUnitControl[0].valueAsNumber == 0) ||
                        (value > 0 && subUnitControl[0].valueAsNumber > 0);
                },
                errorMessage : "اصلي او فرعي واحدونه باید دواړه صفر وي یا دواړه له صفر څخه زیات وي"
            },
            {
                validator: function(value){
                    return value >= 0;
                },
                errorMessage: "عدد باید له صفر څخه کوچنی نه وي"
            }]);

            createItemFormValidator.addField(subUnitControl[0], [
            {
                validator: function(value){
                    return (value == 0 && mainUnitControl[0].valueAsNumber == 0) ||
                        (value > 0 && mainUnitControl[0].valueAsNumber > 0);
                },
                errorMessage : "اصلي او فرعي واحدونه باید دواړه صفر وي یا دواړه له صفر څخه زیات وي"
            },
            {
                validator: function(value){
                    return value >= 0;
                },
                errorMessage: "عدد باید له صفر څخه کوچنی نه وي"
            }]);

            tr.appendTo(dataTable);
        });
    },
    error : function(response){
        showToast("success", response);
    }
});

var newCategory = new TomSelect("#newCategory", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
var newUnit = new TomSelect("#newUnit", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });

var editCategory = new TomSelect("#editCategory", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
var editUnit = new TomSelect("#editUnit", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });

var cats = $.get("/api/Inventory/GetActiveCatsList", function(data) {        
    newCategory.addOptions(data);
    newCategory.refreshOptions(false);

    editCategory.addOptions(data);
    editCategory.refreshOptions(false);
});


var units = $.get("/api/Inventory/GetActiveUnitsList", function(data) {
    newUnit.addOptions(data);
    newUnit.refreshOptions(false);

    editUnit.addOptions(data);
    editUnit.refreshOptions(false);
});


var newItemFormData = {
    name: "#newName",
    code : "#newItemCode",
    minQuantity: "#newMinItems",
    category: "#newCategory",
    mainUnit: "#newUnit",
    image: "#newImage"
}
var createItemFormValidator = itemFormValidator("#createItemForm", newItemFormData);
createItemFormValidator.onSuccess(function (event) {
    event.preventDefault();

    const item = {
        unitConversions: $("#newSubUnits tr").map(function () {
            const cells = $(this).find("td");

            return {
                subUnitId: Number(cells.eq(0).text().trim()),
                mainUnitQuantity: Number(cells.eq(2).find("input").val() || 0),
                subUnitQuantity: Number(cells.eq(3).find("input").val() || 0),
                remarks: cells.eq(4).find("input").val()
            };
        }).get()
    };
    var formData = new FormData();

    // Append primary fields
    formData.append("Name", $("#newName").val().trim());
    formData.append("SecondName", $("#newSecondName").val().trim());
    formData.append("Code", $("#newItemCode").val().trim());
    formData.append("SerialNo", $("#newSerialNo").val().trim());
    formData.append("Description", $("#newDescription").val().trim());
    formData.append("MinQuantity", Number($("#newMinItems").val()));
    formData.append("CategoryId", Number($("#newCategory")[0].tomselect.getValue()));
    formData.append("MainUnitId", Number($("#newUnit")[0].tomselect.getValue()));

    // Append the nested list using indexed notation
    item.unitConversions.forEach((conversion, index) => {
        formData.append(`UnitConversions[${index}].SubUnitId`, conversion.subUnitId);
        formData.append(`UnitConversions[${index}].MainUnitQuantity`, conversion.mainUnitQuantity);
        formData.append(`UnitConversions[${index}].SubUnitQuantity`, conversion.subUnitQuantity);
        formData.append(`UnitConversions[${index}].Remarks`, conversion.remarks || "");
    });

    // Append the file
    if ($("#newImage")[0].files[0]) {
        formData.append("ImageFile", $("#newImage")[0].files[0]);
    }

    $.ajax({
        url: "/api/Inventory/CreateItem",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false, 
        success: function (result) {
            showToast("success", "جنس ثبت سو");
            getItemsList();
            $("#createItemForm")[0].reset();
            $("#createItemModal").modal("hide");
        },
        error: function (xhr) {
            showToast("warning", xhr.responseText);
            console.error(xhr.responseText);
        }
    });
});

var editItemFormData = {
    name: "#editName",
    code : "#editItemCode",
    minQuantity: "#editMinItems",
    category: "#editCategory",
    mainUnit: "#editUnit",
    image : "#editImage"
}

var editItemFormValidator = itemFormValidator("#editItemForm", editItemFormData);
editItemFormValidator.onSuccess(function (event) {
    event.preventDefault();

    const item = {
        unitConversions: $("#editSubUnits tr").map(function () {
            const cells = $(this).find("td");

            return {
                id: Number(cells.eq(0).text().trim()),
                subUnitId: Number(cells.eq(1).text().trim()),
                mainUnitQuantity: Number(cells.eq(3).find("input").val() || 0),
                subUnitQuantity: Number(cells.eq(4).find("input").val() || 0),
                remarks: cells.eq(5).find("input").val()
            };
        }).get()
    };
    var formData = new FormData();

    // Append primary fields
    formData.append("id", $("#itemId").val());
    formData.append("Name", $("#editName").val().trim());
    formData.append("SecondName", $("#editSecondName").val().trim());
    formData.append("Code", $("#editItemCode").val().trim());
    formData.append("SerialNo", $("#editSerialNo").val().trim());
    formData.append("Description", $("#editDescription").val().trim());
    formData.append("MinQuantity", Number($("#editMinItems").val()));
    formData.append("CategoryId", Number($("#editCategory")[0].tomselect.getValue()));
    formData.append("MainUnitId", Number($("#editUnit")[0].tomselect.getValue()));

    // Append the nested list using indexed notation
    item.unitConversions.forEach((conversion, index) => {
        formData.append(`UnitConversions[${index}].Id`, conversion.id);
        formData.append(`UnitConversions[${index}].SubUnitId`, conversion.subUnitId);
        formData.append(`UnitConversions[${index}].MainUnitQuantity`, conversion.mainUnitQuantity);
        formData.append(`UnitConversions[${index}].SubUnitQuantity`, conversion.subUnitQuantity);
        formData.append(`UnitConversions[${index}].Remarks`, conversion.remarks || "");
    });

    // Append the file
    if ($("#editImage")[0].files[0]) {
        formData.append("ImageFile", $("#editImage")[0].files[0]);
    }

    $.ajax({
        url: "/api/Inventory/UpdateItem",
        type: "PUT",
        data: formData,
        processData: false,
        contentType: false, 
        success: function (result) {
            showToast("success", "جنس ثبت سو");
            getItemsList();
            $("#editItemForm")[0].reset();
            $("#editItemModal").modal("hide");
        },
        error: function (xhr) {
            showToast("warning", xhr.responseText);
            console.error(xhr.responseText);
        }
    });
});



function itemFormValidator(formId, form){
    var newFormValidator = new JustValidate(formId);
    newFormValidator.addField(form.name, [
    {
        rule : "required",
        errorMessage : "نوم اړین دی"
    }
    ])
    .addField(form.code, [
    {
        rule: "required",
        errorMessage: "کوډ حتمی دی"
    }])
    .addField(form.minQuantity, [
    {
        rule: "minNumber",
        value: 0,
        errorMessage: "د کمښت خبرتیا نمبر باید له صفر کم نه وي."
    }])
    .addField(form.category, [
    {
        rule: "required",
        errorMessage: "کټیګوري حتمی دی"
    }])
    .addField(form.mainUnit, [
    {
        rule: "required",
        errorMessage: "عمومي واحد حتمی دی"
    }])
    .addField(form.image, [
    {
      rule: 'files',
      value: {
        files: {
          extensions: ['jpeg', 'jpg', 'png'],
          maxSize: 500000,
          types: ['image/jpeg', 'image/jpg', 'image/png'],
        },
        errorMessage : "یوازي عکس آپلوډ کړی"
      },
      errorMessage : "تر 500 KB اضافه عکس نه آپلوډکیږي"
    }])
    return newFormValidator;
}

$("#createNewItem").click(function(){
    $.ajax({
        url: "/api/Inventory/Next-Code",
        type: "GET",
        success: function(response){
            $("#newItemCode").val(response);
        },
        error : function(response){
            showToast("warning", response);
        }
    });
    $("#createItemModal").modal("show");
});
// for change activation
$(document).on("click", ".btn-change-activation", function(event){
    var id = $(this).data("id");
    sweetAlert("تاسو اطمناني یاست؟", "تاسو اطمناني یاست، غواړی د جنس فعالیت تغیر کړی؟")
    .then((result) => {
        if (result.isConfirmed) {

            $.ajax({
                url: "/api/Inventory/ChangeItemActivation/" + id,  
                type: "PUT",

                success: function (response) {

                    showToast("success", "د انتخاب سوي جنس فعالیت تغیر کړل سو.");

                    getItemsList();
                },

                error: function (responsive) {
                    showToast("warning", responsive.responseText);
                }
            });

        }
    });
})

$(document).on("click", ".btn-edit", function(event){
    var data = $(this).data("row");

    $("#itemId").val(data.id);
    $("#editName").val(data.name);
    $("#editSecondName").val(data.secondName);
    $("#editItemCode").val(data.code);
    $("#editSerialNo").val(data.serialNo);
    $("#editDescription").val(data.description);
    $("#editMinItems").val(data.minQuantity);
    $("#editCategory")[0].tomselect.setValue(data.categoryId);
    $("#editUnit")[0].tomselect.setValue(data.mainUnitId);

    $.ajax({
        url: "/api/Inventory/GetUnitConversions/" + data.id,
        type: "GET",
        success : function(response){
            var dataTable = $("#editSubUnits");
            dataTable.find("tr").each(function () {
                const cells = $(this).find("td");
                editItemFormValidator.removeField(cells.eq(3).find("input")[0]);
                editItemFormValidator.removeField(cells.eq(4).find("input")[0]);
            });
            dataTable.empty();
            response.forEach(function(row){
                var tr = $("<tr>");
                $("<td>").addClass("d-none").text(row.id).appendTo(tr);
                $("<td>").addClass("d-none").text(row.subUnitId).appendTo(tr);
                $("<td>").text(row.subUnitName).appendTo(tr);

                var mainAmountTD = $("<td>");
                var mainAmountTDControl = $("<input>").attr("type", "number").addClass("form-control form-main-amount").val(row.mainUnitQuantity);
                mainAmountTDControl.appendTo(mainAmountTD);
                mainAmountTD.appendTo(tr);
                
                var subAmountTD = $("<td>");
                var subAmountTDControl = $("<input>").attr("type", "number").addClass("form-control form-sub-amount").val(row.subUnitQuantity);
                subAmountTDControl.appendTo(subAmountTD);
                subAmountTD.appendTo(tr);

                editItemFormValidator.addField(mainAmountTDControl[0], [
                {
                    validator: function(value){
                        return (value == 0 && subAmountTDControl[0].valueAsNumber == 0) ||
                            (value > 0 && subAmountTDControl[0].valueAsNumber > 0);
                    },
                    errorMessage : "اصلي او فرعي واحدونه باید دواړه صفر وي یا دواړه له صفر څخه زیات وي"
                },
                {
                    validator: function(value){
                        return value >= 0;
                    },
                    errorMessage: "عدد باید له صفر څخه کوچنی نه وي"
                }]);

                editItemFormValidator.addField(subAmountTDControl[0], [
                {
                    validator: function(value){
                        return (value == 0 && mainAmountTDControl[0].valueAsNumber == 0) ||
                            (value > 0 && mainAmountTDControl[0].valueAsNumber > 0);
                    },
                    errorMessage : "اصلي او فرعي واحدونه باید دواړه صفر وي یا دواړه له صفر څخه زیات وي"
                },
                {
                    validator: function(value){
                        return value >= 0;
                    },
                    errorMessage: "عدد باید له صفر څخه کوچنی نه وي"
                }]);
                
                var remarksTD = $("<td>");
                var remarksTDControl = $("<input>").addClass("form-control").val(row.remarks);
                remarksTDControl.appendTo(remarksTD);
                remarksTD.appendTo(tr);

                tr.appendTo(dataTable);
            });
        }
    });

    $("#editItemModal").modal("show");
});

