@{
    ViewData["title"] = "د اجناسو موجودي";
    ViewData["StockItems"] = "active";
    ViewData["Inventory"] = "active";
}
@section Styles {
<link href="~/lib/flatpickr-jalali-support/dist/flatpickr.min.css" rel="stylesheet" />
<link href="~/lib/flatpickr-jalali-support/dist/themes/soft-card.css" rel="stylesheet" />
<link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
}
<div class="row row-deck row-cards">
    <div class="card">
        <div class="card-header">
            <h3 class="h3">@ViewData["title"]</h3>
        </div>
        <div class="card-body">
            <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#newStockItem">
                نوې موجودي
                <i class="fas fa-plus ms-3"></i>
            </button>
        <table class="table table-hover table-bordered table-responsive table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>جنس</th>
                    <th>عمومي واحد</th>
                    <th>ګدام</th>
                    <th>موجودي</th>
                    <th style="width: 100px;">کړني</th>
                </tr>
            </thead>
            <tbody id="stockItemsList">
            </tbody>
        </table>
        </div>
    </div>
</div>

<div class="modal fade" id="newStockItem">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h2>نوې موجودي</h2>
            </div>
            <form id="newStockItemsForm">
                <input type="hidden" id="newStockItemId">
                <div class="modal-body py-4">
                    <h3 class="h3 text-muted" id="itemname"></h3>
                </div>
                <div class="modal-body py-4">
                        <button class="btn btn-sm btn-primary my-1" id="addNewStockItemRow">
                            <i class="fas fa-plus"></i>
                        </button>
                    
                    <table class="table table-bordered table-responsive table-hover table-striped">
                        <thead>
                            <tr>
                                <th>نېټه</th>
                                <th style="width: 180px;">جنس</th>
                                <th style="width: 180px;">واحد</th>
                                <th style="width: 180px;">ګدام</th>
                                <th>تعداد</th>
                                <th>ملاحظات</th>
                                <th style="width: 50px;">حذف</th>
                            </tr>
                        </thead>
                        <tbody id="newStockItemsRows"></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col-auto">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="stockExchangeModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h2>د ګدامونو ترمنځ تبادله</h2>
            </div>
            <form id="stockExchangeForm">
                <input type="hidden" id="stockExchangeItemId">
                <div class="modal-body py-4">
                    <h3 class="h3 text-dark">جنس / عمومي واحد او تعداد / ګدام</h3>
                    <h3 class="h3 text-muted" id="stockExchangeItemName"></h3>
                </div>
                <div class="modal-body py-4">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockExchangeDate">نېټه</label>
                                <input type="text" class="form-control" id="stockExchangeDate" disabled />
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockExchangeToStock">ګدام ته</label>
                                <select class="form-control" id="stockExchangeToStock"></select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockExchangeUnit">واحد</label>
                                <select class="form-control" id="stockExchangeUnit"></select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockExchangeQuantity">تعداد</label>
                                <input type="number" class="form-control" id="stockExchangeQuantity">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockExchangeRemarks">تشریح</label>
                                <textarea class="form-control" id="stockExchangeRemarks"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col-auto">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="stockOutageModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h2>د جنس اخراجول</h2>
            </div>
            <form id="stockOutageForm">
                <input type="hidden" id="stockOutageItemId">
                <div class="modal-body py-4">
                    <h3 class="h3 text-dark">جنس / عمومي واحد او تعداد / ګدام</h3>
                    <h3 class="h3 text-muted" id="stockOutageItemName"></h3>
                </div>
                <div class="modal-body py-4">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockOutageDate">نېټه</label>
                                <input type="text" class="form-control" id="stockOutageDate" disabled />
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockOutageActionType">د عملېې ډول</label>
                                <select class="form-control" id="stockOutageActionType"></select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockOutageUnit">واحد</label>
                                <select class="form-control" id="stockOutageUnit"></select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockOutageQuantity">تعداد</label>
                                <input type="number" class="form-control" id="stockOutageQuantity">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" for="stockOutageRemarks">تشریح</label>
                                <textarea class="form-control" id="stockOutageRemarks"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col-auto">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/flatpickr-jalali-support/dist/flatpickr.min.js"></script>
<script src="~/lib/flatpickr-jalali-support/dist/l10n/fa.js"></script>
<script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
<script src="~/lib/moment-jalali/dist/jalali-moment.browser.js"></script>
@* Generals *@
<script>
$(document).ready(stockItemsList());
var stocks = null;
$.get("/api/Inventory/GetActiveStockList/", function(rows) {
    stocks = rows;
});
var activeItems = null;
$.get("/api/Inventory/GetActiveItemsList/", function(rows) {
    activeItems = rows;
});

function stockItemsList(){
    $.ajax({
        url: "/api/Inventory/GetStockItems",
        type: "GET",
        success : function(respondedData){
            var dataTable = $("#stockItemsList");
            dataTable.empty();
            respondedData.forEach(function(data){
                var tr = $("<tr>");
                $("<td>").text(data.id).appendTo(tr);
                $("<td>").text(data.itemName).appendTo(tr);
                $("<td>").text(data.unitName).appendTo(tr);
                $("<td>").text(data.stockName).appendTo(tr);
                $("<td>").text(data.quantity).appendTo(tr);
                var actionsCell = $("<td>");
                var actionsDiv = $("<div>").addClass("btn-group");
                actionsDiv.appendTo(actionsCell);
                exportBtn = $("<button>").addClass("btn btn-sm btn-primary btn-export").attr("data-row", JSON.stringify(data)).text("اخراج");
                exportBtn.appendTo(actionsDiv);
                exchangeBtn = $("<button>").addClass("btn btn-sm btn-success btn-exchange").attr("data-row", JSON.stringify(data)).text("تبادله");
                exchangeBtn.appendTo(actionsDiv);
                actionsCell.appendTo(tr);
                tr.appendTo(dataTable);

            });
        },
        error : function(error){
            console.error(error);
        }
    });
}

function FlatPickerComponent(control){
    flatpickr(control, {
        locale: "fa",
        defaultDate: new Date(),
        allowInput: true
    });
}
</script>

@* List of new items *@
<script>
var stockItemsValidator = new JustValidate("#newStockItemsForm");

$("#addNewStockItemRow").click(async function(event){
    event.preventDefault();

    if ($("#newStockItemsRows tr").length > 0) {
        var currentRowsAreValid = await stockItemsValidator.revalidate();

        if (!currentRowsAreValid) {
            return;
        }
    }


    var newRow = $("<tr>");
    var dateCell = $("<td>");
    var datefield = $("<input>").addClass("form-control").attr("placeholder", "نېټه");
    datefield.appendTo(dateCell);
    FlatPickerComponent(dateCell.find("input")[0]);
    dateCell.appendTo(newRow);
    
    var itemCell = $("<td>");
    var itemsField = $("<select>").addClass("form-select select-item").attr("name", "itemId");
    itemsField.appendTo(itemCell);
    itemCell.appendTo(newRow);
    var itemsSelect = new TomSelect(itemsField[0], {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
    itemsSelect.addOptions(activeItems);

    var unitCell = $("<td>");
    var unitField = $("<select>").addClass("form-select").attr("name", "unitId");
    unitField.appendTo(unitCell);
    unitCell.appendTo(newRow);
    var unitSelect = new TomSelect(unitField[0], {
        valueField: "id",
        labelField: "subUnitName",
        searchField: "subUnitName"
    });

    var stockCell = $("<td>");    
    var stockField = $("<select>").addClass("form-select").attr("name", "stockId");
    stockField.appendTo(stockCell);
    stockCell.appendTo(newRow);
    var stocksSelect = new TomSelect(stockField[0], {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
    stocksSelect.addOptions(stocks);

    var quantityCell = $("<td>");
    var quantityField = $("<input>").addClass("form-control").attr("type", "number");
    quantityField.appendTo(quantityCell);
    quantityCell.appendTo(newRow);

    $("<td>").html('<input type="text" class="form-control" name="remarks">').appendTo(newRow);

    var deleteCell = $("<td>");
    var deleteBtn = $("<button>").addClass("btn btn-sm btn-danger btn-remove-row").html("<i class='fas fa-trash-can'></i>");

    deleteBtn.appendTo(deleteCell);
    deleteCell.appendTo(newRow);
    newRow.appendTo("#newStockItemsRows");

    stockItemsValidator.addField(datefield[0], [
    {
        rule: "required",
        errorMessage: "نېټه اړین ده"
    }]);
    stockItemsValidator.addField(itemsField[0], [
    {
        rule: "required",
        errorMessage: "جنس اړین دی"
    }]);
    stockItemsValidator.addField(unitField[0], [
    {
        rule: "required",
        errorMessage: "واحد اړین دی"
    }]);
    stockItemsValidator.addField(stockField[0], [
    {
        rule: "required",
        errorMessage: "ګدام اړین دی"
    }]);
    stockItemsValidator.addField(quantityField[0], [
    {
        rule: "required",
        errorMessage: "تعداد اړین دی"
    },{
            validator: function(value) {
                return Number(value) > 0;
            },
            errorMessage: "تعداد باید له صفر څخه زیات وي"
    }]);
    stocksSelect.on("change", function () {
        stockItemsValidator.revalidateField(stockField[0]);
    });
    itemsSelect.on("change", function () {
        stockItemsValidator.revalidateField(itemsField[0]);
    });

    unitSelect.on("change", function () {
        stockItemsValidator.revalidateField(unitField[0]);
    });
});
stockItemsValidator.onSuccess(function(event){
    if(!event){
        return;
    }
    event.preventDefault();

    const item = {
        unitConversions: $("#newStockItemsRows tr").map(function (){
            const cells = $(this).find("td");
            // var creationDate = moment(cells.eq(0).find("input").val(), "YYYY-MM-DD").toDate();
            // var creationDate = moment.from(cells.eq(0).find("input").val(), 'fa', 'YYYY/MM/DD').locale('en').format('YYYY/MM/DD');
            var creationDate = moment.from("1405/5/11", 'fa', 'YYYY/MM/DD').locale('en')._d;
            return {
                creationDate: creationDate,
                itemId: Number(cells.eq(1).find("select").val()),
                unitId: Number(cells.eq(2).find("select").val()),
                stockId: Number(cells.eq(3).find("select").val()),
                quantity: Number(cells.eq(4).find("input").val() || 0),
                remarks: cells.eq(5).find("input").val()
            };
        }).get()
    };
    //console.log(item.unitConversions);
    $.ajax({
        url: "/api/Inventory/NewItemStockEntry",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(item.unitConversions),
        success : function(response){
            showToast("success", "ثبت سو.");
            $("#newStockItemsRows").empty();
            $("#newStockItemsForm")[0].reset();
            $("#newStockItem").modal("hide");
            stockItemsList();
        },
        error : function(error){
            showToast("warning", error.responseText);
        }
    });
});
$(document).on("change", ".select-item", function () {
    var currentRow = $(this).closest("tr");
    var itemId = this.tomselect.getValue();

    var unitElement = currentRow.find('select[name="unitId"]')[0];
    var unitTomSelect = unitElement.tomselect;

    unitTomSelect.clear(true);
    unitTomSelect.clearOptions();

    if (!itemId) {
        return;
    }

    $.get("/api/Inventory/GetUnitConversionsOnly/" + itemId, function (units) {
        unitTomSelect.addOptions(units);
        unitTomSelect.refreshOptions(false);
    });
});

$(document).on("click", ".btn-remove-row", function (event) {
    event.preventDefault();
    $(this).closest("tr").remove();
});
$("#newStockItemsForm").on("reset", function(event){
    $("#newStockItemsRows").empty();
});
</script>

@* Exchange *@
<script>
FlatPickerComponent("#stockExchangeDate");
var stockExchangeUnit = new TomSelect("#stockExchangeUnit", {
        valueField: "id",
        labelField: "subUnitName",
        searchField: "subUnitName"
    });

var stocksSelect = new TomSelect("#stockExchangeToStock", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
var activeStocks = null;
$.get("/api/Inventory/GetActiveStockList/", function(rows) {
    activeStocks = rows;
});
var stockExchangeFormValidation = new JustValidate("#stockExchangeForm");
stockExchangeFormValidation.addField("#stockExchangeDate", [
    {
        rule: "required",
        errorMessage: "نېټه اړین ده"
    }
]);
stockExchangeFormValidation.addField("#stockExchangeUnit", [
    {
        rule: "required",
        errorMessage: "واحد اړین دی"
    }
]);
stockExchangeFormValidation.addField("#stockExchangeToStock", [
    {
        rule: "required",
        errorMessage: "ګدام اړین دی"
    }
]);
stockExchangeFormValidation.addField("#stockExchangeQuantity", [
    {
        rule: "required",
        errorMessage: "تعداد اړین دی"
    },
    {
        validator: function(value) {
            return Number(value) > 0;
        },
        errorMessage: "تعداد باید له صفر څخه زیات وي"
    }
]);
stockExchangeFormValidation.addField("#stockExchangeRemarks", [
    {
        rule: "required",
        errorMessage: "تشریح اړین دی"
    }
]);
$(document).on("click", ".btn-exchange", function(event){
    var data = $(this).data("row");

    $("#stockExchangeItemName").text(`${data.itemName} - ${data.quantity} ${data.unitName} - ${data.stockName}`);
    $("#stockExchangeItemId").val(data.id);    
    const fp = document.querySelector("#stockExchangeDate")._flatpickr;

    fp.setDate(new Date());

    var filteredStocks = activeStocks.filter(function(stock) {
        return stock.id !== data.stockID;
    });
    stocksSelect.clear();
    stocksSelect.clearOptions();
    stocksSelect.addOptions(filteredStocks);
    stocksSelect.refreshOptions(false);

    stockExchangeUnit.clear(true);
    stockExchangeUnit.clearOptions();

    $.get("/api/Inventory/GetUnitConversionsOnly/" + data.itemID, function (units) {
        stockExchangeUnit.addOptions(units);
        stockExchangeUnit.refreshOptions(false);
    });
    $("#stockExchangeModal").modal("show");
});
stockExchangeFormValidation.onSuccess(function(event){
    if(!event){
        return;
    }
    event.preventDefault();

    const exchangeData = {
        id: Number($("#stockExchangeItemId").val()),
        unitID: Number($("#stockExchangeUnit").val()),
        stockID: Number($("#stockExchangeToStock").val()),
        quantity: Number($("#stockExchangeQuantity").val() || 0),
        remarks: $("#stockExchangeRemarks").val()
    };

    $.ajax({
        url: "/api/Inventory/SaveStockExchange",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(exchangeData),
        success : function(response){
            showToast("success", "تبادله ثبت سو.");
            $("#stockExchangeForm")[0].reset();
            $("#stockExchangeModal").modal("hide");
            stockItemsList();
        },
        error : function(error){
            showToast("warning", error.responseText);
        }
    });
});
</script>

@* Outage/Export *@
<script>
FlatPickerComponent("#stockOutageDate");
var stockOutageUnit = new TomSelect("#stockOutageUnit",{
    valueField: "id",
    labelField: "subUnitName",
    searchField: "subUnitName"
});

var stockOutageActionType = new TomSelect("#stockOutageActionType", {
        valueField: "id",
        labelField: "name",
        searchField: "name"
    });
$.get("/api/Inventory/GetStockOutageActionTypes/", function(rows) {
    stockOutageActionType.addOptions(rows);
});

var stockOutageFormValidator = new JustValidate("#stockOutageForm");

$(document).on("click", ".btn-export", function(event){
    var data = $(this).data("row");
    //
    
    $("#stockOutageItemName").text(`${data.itemName} - ${data.quantity} ${data.unitName} - ${data.stockName}`);
    $("#stockOutageItemId").val(data.id);    
    const fp = document.querySelector("#stockOutageDate")._flatpickr;

    fp.setDate(new Date());

    stockOutageUnit.clear(true);
    stockOutageUnit.clearOptions();

    $.get("/api/Inventory/GetUnitConversionsOnly/" + data.itemID, function (units) {
        stockOutageUnit.addOptions(units);
        stockOutageUnit.refreshOptions(false);
    });

    stockOutageFormValidator.addField("#stockOutageDate", [
    {
        rule: "required",
        errorMessage: "نېټه حتمي ده"
    }
    ]);

    stockOutageFormValidator.addField("#stockOutageActionType", [
    {
        rule: "required",
        errorMessage: "د عملیې ډول حتمي دئ"
    }
    ]);

    stockOutageFormValidator.addField("#stockOutageUnit", [
    {
        rule: "required",
        errorMessage: "واحد حتمي دئ"
    }
    ]);

    stockOutageFormValidator.addField("#stockOutageQuantity", [
    {
        rule: "required",
        errorMessage: "مبلغ حتمي دئ"
    },
    {
        validator: function(value) {
            return Number(value) > 0;
        },
        errorMessage: "تعداد باید له صفر څخه زیات وي"
    }
    ]);

    stockOutageFormValidator.addField("#stockOutageRemarks", [
    {
        rule: "required",
        errorMessage: "تشریح حتمي دئ"
    }
    ]);
    $("#stockOutageModal").modal('show');
});
stockOutageFormValidator.onSuccess(function(event){
    event.preventDefault();
    var data = {
        id : Number($("#stockOutageItemId").val()),
        unitID : Number($("#stockOutageUnit").val()),
        quantity : Number($("#stockOutageQuantity").val()),
        transactionType : Number($("#stockOutageActionType").val())
    };
    console.log(data);
    $.ajax({
        url: "/api/Inventory/ExportOrDemageItem/",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(data),
        success : function(response){
            showToast("success", "عملیه ثبت سو.");
            $("#stockOutageForm")[0].reset();
            $("#stockOutageModal").modal("hide");
            stockItemsList();
        },
        error : function(error){
            showToast("warning", error.responseText);
        }
    });
});
</script>
}