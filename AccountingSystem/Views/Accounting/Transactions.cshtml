@{
    ViewData["title"] = "نقدي معاملات";
    ViewData["Accounting"] = "active";
    ViewData["Transactions"] = "active";
}
@section Styles {
<link href="~/lib/flatpickr-jalali-support/dist/flatpickr.min.css" rel="stylesheet" />
<link href="~/lib/flatpickr-jalali-support/dist/themes/soft-card.css" rel="stylesheet" />
<link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
<style>
    .item-image {
        width: 90px;
    }
</style>
}
<div class="row row-deck row-cards">
    <div class="card">
        <div class="card-header">
            <h3 class="h3">@ViewData["title"]</h3>
        </div>
        <div class="card-body">
            <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createNewTransaction" >
                <i class="fas fa-plus pe-2"></i>
                نوې معامله</button>
            <form class="my-3" id="searchForm">
                <div class="row align-items-end">
                    <div class="col-auto">
                        <div class="form-group" for="accountId">
                            <label class="form-label">حساب</label>
                            <select id="accountId" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="form-group">
                            <label class="form-label" for="currencyId">اسعار</label>
                            <select id="currencyId" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="form-group">
                            <label class="form-label" for="startDate">شروع نېټه</label>
                            <input type="text" id="startDate" class="form-control" />
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="form-group">
                            <label class="form-label" for="endDate">ختم نېټه</label>
                            <input type="text" id="endDate" class="form-control" />
                        </div>
                    </div>
                    <div class="col-auto">
                        
                        <button type="submit" class="btn btn-primary"> 
                            <i class="fas fa-search pe-3"></i>
                             پلټنه</button>
                    </div>
                </div>
            </form>
            <table class="table table-hover table-bordered table-responsive table-striped">
                <thead>
                    <tr>
                        <th>نېټه</th>
                        <th>حساب</th>
                        <th>اسعار</th>
                        <th>د معاملې ډول</th>
                        <th>رسیدګي</th>
                        <th>بردګي</th>
                        <th>بلانس</th>
                        <th>تشریح</th>
                        <th>سند</th>
                    </tr>
                </thead>
                <tbody id="journalList">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createNewTransaction" tabindex="0">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
            <button type="reset" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <h2>نوې معامله</h2>
            </div>
            <form id="newTransactionForm">
                <div class="modal-body py-4">
                    <div class="row mb-2">
                        <div class="form-group">
                            <label for="transactionDate" class="form-label">نېټه</label>
                            <input type="text" class="form-control" id="transactionDate">
                        </div>
                    </div>
                    <div class="row my-2">
                        <div class="col">
                            <div class="form-group">
                                <label for="debitCurrency" class="form-label">بردګي اسعار</label>
                                <select class="form-control" id="debitCurrency"></select>
                            </div>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="creditCurrency" class="form-label">رسیدګي اسعار</label>
                                <select class="form-control" id="creditCurrency"></select>
                            </div>
                        </div>
                    </div>

                    <div class="row my-2">
                        <div class="col">
                            <div class="form-group">
                                <label for="debitAccount" class="form-label">بردګي حساب</label>
                                <select class="form-control" id="debitAccount"></select>
                            </div>
                            <span class="text-muted" id="debitAccountText"></span>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="creditAccount" class="form-label">رسیدګي حساب</label>
                                <select class="form-control" id="creditAccount"></select>
                            </div>
                            <span class="text-muted" id="creditAccountText"></span>
                        </div>
                    </div>

                    <div class="row my-2">
                        <div class="col">
                            <div class="form-group">
                                <label for="creditAmount" class="form-label">مبلغ</label>
                                <input type="number" class="form-control" id="creditAmount">
                            </div>
                            <span class="text-muted" id="exchangingAmountText"></span>
                        </div>
                        <div class="col">
                            <div class="form-group">
                                <label for="remarks" class="form-label">تشریحات</label>
                                <textarea class="form-control" id="remarks"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="row my-2">
                        <div class="col">
                            <div class="form-group">
                                <label for="image" class="form-label">سند عکس</label>
                                <input type="file" class="form-control" id="documentImage">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-body pb-3">
                    <h3 class="h3">د حسابونو محاسبه (په عدد او تورو سره)</h3>
                    <p id="debitAmountToWords"></p>
                    <p id="creditAmountToWords"></p>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <button type="submit" class="btn btn-primary w-100"> تائید </button>
                            </div>
                            <div class="col">
                                <button class="btn w-100" type="reset" data-bs-dismiss="modal"> لغوه </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    
<script src="~/lib/flatpickr-jalali-support/dist/flatpickr.min.js"></script>
<script src="~/lib/flatpickr-jalali-support/dist/l10n/fa.js"></script>
<script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
<script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
<script src="~/lib/moment-jalali/dist/jalali-moment.browser.js"></script>
<script src="~/js/numberToWords.js"></script>
<script>
function DateComponent(control){
    flatpickr(control, {
        locale: "fa",
        defaultDate: new Date(),
        allowInput: true
    });
}
DateComponent("#endDate");
DateComponent("#startDate");

var  accountIds = new TomSelect("#accountId", {
    valueField: 'id',
    labelField: 'name',
    searchField: ['name', 'code', 'accountTypeName'],
    render: {
        option: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        },
        item: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        }
    }
});

var currencyIds = new TomSelect("#currencyId", {
    valueField: 'id',
    labelField: 'name',
    searchField: 'name'
});
var debitCurrency = new TomSelect("#debitCurrency", {
    valueField: 'id',
    labelField: 'name',
    searchField: 'name'
});
var creditCurrency = new TomSelect("#creditCurrency", {
    valueField: 'id',
    labelField: 'name',
    searchField: 'name'
});
var currencyiesList = [];
$.get("/api/Currency/Currencies/Simple/", function(rows){
    currencyIds.addOptions(rows);
    debitCurrency.addOptions(rows);
    debitCurrency.setValue(rows[0].id);
    creditCurrency.addOptions(rows);
    creditCurrency.setValue(rows[0].id);
    currencyiesList = rows;
});

function accountDisplay(data) {
    return `${data.name} - ${data.code} - ${data.accountTypeName}`;
}

var debitAccountSelect = new TomSelect("#debitAccount", {
    valueField: 'id',
    labelField: 'name',
    searchField: ['name', 'code', 'accountTypeName'],
    render: {
        option: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        },
        item: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        }
    }
});

var creditAccountSelect = new TomSelect("#creditAccount", {
    valueField: 'id',
    labelField: 'name',
    searchField: ['name', 'code', 'accountTypeName'],
    render: {
        option: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        },
        item: function(data, escape) {
            return `<div>${escape(accountDisplay(data))}</div>`;
        }
    }
});

var accountsList = [];
var debitAccountsList = [];
$.get("/api/Accounts/GetAccountsList/", function (data) {
    accountsList = data;
    debitAccountsList = data.filter(x => [1, 2,  3, 4, 5, 6, 8, 9].includes(x.accountTypeId));
    debitAccountSelect.addOptions(debitAccountsList);
    accountIds.addOptions(data);
});

$("#debitAccount").change(function(event){
    if(!event.target)
        return;
    var accountId = event.target.tomselect.items[0];
    var getFullAccount = accountsList.filter(x => x.id == accountId)[0];
    switch(getFullAccount.accountTypeId){
        // treasure
        case 1 : 
            creditAccountSelect.clearOptions();
        creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2, 3, 4, 5, 7, 8, 9].includes(x.accountTypeId)));
        break;
        
        // banks
        case 2 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2, 3, 4, 5, 7, 8, 9].includes(x.accountTypeId)));
        break;
        
        // buyers
        case 3 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2, 3, 4, 5].includes(x.accountTypeId)));
        break;
        
        // sellers
        case 4 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2, 3, 4, 5].includes(x.accountTypeId)));
        break;
        
        // both
        case 5 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2, 3, 4, 5].includes(x.accountTypeId)));
        break;
        
        // other revenues
        case 6 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2].includes(x.accountTypeId)));
        break;
        
        // contributors
        case 8 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2].includes(x.accountTypeId)));
        break;
        
        // stuff
        case 9 : 
            creditAccountSelect.clearOptions();
            creditAccountSelect.addOptions(accountsList.filter(x => x.id != accountId && [1, 2].includes(x.accountTypeId)));
        break;
        
    }

    CalculateNumberToWords();
});

$("#creditAccount").change(function(event){
    CalculateNumberToWords();
});
var exchangeField = $("#selectedCurrencyExchange");
$("#creditCurrency").change(function(event){
    $.get(`/api/Currency/GetSingleCurrencyConversion/${$("#creditCurrency").val()}`, function(data){
        creditCurrencyExchange = data.exchangedAmount;
    });
    CalculateNumberToWords();
});

$("#debitCurrency").change(function(event){
    $.get(`/api/Currency/GetSingleCurrencyConversion/${$("#debitCurrency").val()}`, function(data){
        debitCurrencyExchange = data.exchangedAmount;
    });
    CalculateNumberToWords();
});

$("#creditAmount").change(function(event){
    
    $("#exchangingAmountText").text(NumberToWords('', event.target.valueAsNumber));
    CalculatedAccountBalances();
});
$("#newTransactionForm").on("reset", function(event){
    debitCurrency.clear();
    creditCurrency.clear();
    creditAccountSelect.clear();
    creditAccountSelect.clearOptions();
    $("#debitAmountToWords").text("");
    $("#creditAmountToWords").text("");
    $("#debitAccountText").text("");
    $("#creditAccountText").text("");
    $("#exchangingAmountText").text("");
})

function NumberToWords(currencyName, number){
    var humanized = window.humanizeNumberValue(number);
    return `${number} ${currencyName} (${humanized} ${currencyName})`;
}

var creditAccountBalance = 0;
var debitAccountBalance = 0;
var creditCurrencyExchange = 1;
var debitCurrencyExchange = 1;

function CalculateNumberToWords(){
    var debitCurrencyId = debitCurrency.getValue();
    var debitAccountId = debitAccountSelect.getValue();
    var creditCurrencyId = creditCurrency.getValue();
    var creditAccountId = creditAccountSelect.getValue();

    var debitAccountText = $("#debitAccountText");
    var creditAccountText = $("#creditAccountText");


    if(debitAccountId !== "" && debitAccountId !== null){
        $.get(`/api/Accounts/GetAccountCurrencyBalance/${debitCurrencyId}/${debitAccountId}`, function(amount){
            debitAccountBalance = amount.balance;
            debitAccountText.text(NumberToWords(amount.currencyName, amount.balance));
        });
    }

    if(creditAccountId !== "" && creditAccountId !== null){
        $.get(`/api/Accounts/GetAccountCurrencyBalance/${creditCurrencyId}/${creditAccountId}`, function(amount){
            creditAccountBalance = amount.balance;
            creditAccountText.text(NumberToWords(amount.currencyName, amount.balance));
        });
    }


}

function CalculatedAccountBalances(){
    var debitCurrencyId = debitCurrency.getValue();
    var debitAccountId = debitAccountSelect.getValue();

    var creditCurrencyId = creditCurrency.getValue();
    var creditAccountId = creditAccountSelect.getValue();

    
    var selectedDebitCurrency = currencyiesList.filter(x => x.id == Number(debitCurrencyId))[0];
    var selectedCreditCurrency = currencyiesList.filter(x => x.id == Number(creditCurrencyId))[0];

    var selectedDebitAccount = accountsList.filter(x => x.id == Number(debitAccountId))[0];
    var selectedCreditAccount = accountsList.filter(x => x.id == Number(creditAccountId))[0];

    if(debitCurrencyId !== "" && debitAccountId !== "" && creditCurrencyId !== "" && creditAccountId !== ""){
        var exchange = debitCurrencyExchange / creditCurrencyExchange;
        var amount = Number($("#creditAmount").val());
        var exchangedAmount = amount / exchange;
        var calculatedCreditAccount = creditAccountBalance + Number(exchangedAmount.toFixed(3));
        var calculatedDebitAccount = debitAccountBalance - Number(amount.toFixed(3));
        $("#debitAmountToWords").text(selectedDebitAccount.name + " " + NumberToWords(selectedDebitCurrency.name, calculatedDebitAccount));
        $("#creditAmountToWords").text(selectedCreditAccount.name + " " + NumberToWords(selectedCreditCurrency.name, calculatedCreditAccount));
    }
}

var journalEntryFormValidator = new JustValidate("#newTransactionForm");
journalEntryFormValidator.addField("#transactionDate", [
    {
        rule: "required",
        errorMessage: "نېټه ضروري ده"
    }
]);
journalEntryFormValidator.addField("#debitCurrency", [
    {
        validator: function(value){
            return value !== null;
        },
        errorMessage: "بردګي اسعار ضروري دي"
    }
]);
journalEntryFormValidator.addField("#creditCurrency", [
    {
        validator: function(value){
            return value !== null;
        },
        errorMessage: "رسیدګي اسعار ضروري دي"
    }
]);
journalEntryFormValidator.addField("#debitAccount", [
    {
        validator: function(value){
            return value !== '';
        },
        errorMessage: "رسیدګي حساب ضروري دي"
    }
]);
journalEntryFormValidator.addField("#creditAccount", [
    {
        validator: function(value){
            return value !== '';
        },
        errorMessage: "بردګي حساب ضروري دي"
    }
]);
journalEntryFormValidator.addField("#creditAmount", [
    {
        rule: "required",
        errorMessage: "د تبادلې مبلغ ضروري دی"
    },
    {
        validator: function(value){
            return value > 0;
        },
        errorMessage: "د تبادلې مبلغ باید د صفر څخه لوړ وي"
    },
    {
        validator: function(value){
            var debitAccountId = debitAccountSelect.getValue();
            var selectedDebitAccount = accountsList.filter(x => x.id == debitAccountId)[0];

            if (selectedDebitAccount.accountTypeId === 1 || selectedDebitAccount.accountTypeId === 2){
                var exchange = creditCurrencyExchange / debitCurrencyExchange;
                var exchangeAmount = $("#creditAmount").val();
                var result = exchangeAmount / exchange;
                return debitAccountBalance >= result;
            }
            else{return true;}
        },
        errorMessage : "د تبادلې مبلغ د بردګي په حساب کي نه دی مو جود"
    }
]);
journalEntryFormValidator.addField("#remarks", [
    {
        rule: "required",
        errorMessage: "د تشریحات ضروري دی"
    }
]);
journalEntryFormValidator.addField("#documentImage", [
    {
      rule: 'files',
      value: {
        files: {
          extensions: ['jpeg', 'jpg', 'png'],
          maxSize: 5000000,
          types: ['image/jpeg', 'image/jpg', 'image/png'],
        },
        errorMessage : "یوازي عکس آپلوډ کړی"
      },
      errorMessage : "تر 5 MB اضافه عکس نه آپلوډکیږي"
    }])
journalEntryFormValidator.onSuccess(function(event){
    var currentDate = moment.from($("#transactionDate").val(), 'fa', 'YYYY/MM/DD').format("YYYY-MM-DD");
    var formData = new FormData();
    formData.append("Date", currentDate);
    formData.append("CreditCurrencyId", Number(creditCurrency.getValue()));
    formData.append("DebitCurrencyId", Number(debitCurrency.getValue()));
    formData.append("CreditAccountId", Number(creditAccountSelect.getValue()));
    formData.append("DebitAccountId", Number(debitAccountSelect.getValue()));
    formData.append("Amount", Number($("#creditAmount").val()));
    formData.append("Remarks", $("#remarks").val());
    if ($("#documentImage")[0].files[0]) {
        formData.append("Image", $("#documentImage")[0].files[0]);
    }

    $.ajax({
        url: "/api/Journal/NewJournalEntry",
        type: "POST",
        data: formData,
        processData: false,
        contentType: false, 
        success: function (result) {
            showToast("success", "نوې انټري ثبت سوه");
            $("#newTransactionForm")[0].reset();
            $("#createNewTransaction").modal("hide");
        },
        error: function (xhr) {
            showToast("warning", xhr.responseText);
            console.error(xhr.responseText);
        }
    });
});

$(document).ready(function(){
    GetTodayJournal();
});

function GetTodayJournal(){
    $.ajax({
        url: "/api/Journal/GetTodayJournal",
        type: "GET",
        success : function(respondedData){
            var dataTable = $("#journalList");
            dataTable.empty();
            respondedData.forEach(function(data){
                var tr = $("<tr>");
                $("<td>").text(moment(data.date).format("jYYYY/jMM/jDD HH:mm:ss")).appendTo(tr);
                $("<td>").text(data.accountName).appendTo(tr);
                $("<td>").text(data.currencyName).appendTo(tr);
                $("<td>").text(data.transactionTypeName).appendTo(tr);
                $("<td>").text(data.credit).appendTo(tr);
                $("<td>").text(data.debit).appendTo(tr);
                $("<td>").text(data.balance).appendTo(tr);
                $("<td>").text(data.remarks).appendTo(tr);
                $("<td>").html(`<img src='/Journal/${data.photo}' class='item-image' />`).appendTo(tr);
                tr.appendTo(dataTable);

            });
        },
        error : function(error){
            console.error(error);
        }
    });
}

</script>
}