@using AccountingSystem.Models.Identity
@using Microsoft.AspNetCore.Identity
@{
    
}
<!DOCTYPE html>
<html lang="ps-AF" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler-flags.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.rtl.min.css" />
    <link href="~/lib/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/regular.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/solid.min.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/MainIcon.ico" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body dir="rtl">

    <main class="page">
        <header class="navbar navbar-expand-lg d-print-none">
            <div class="container-xxl">
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbar-menu"
                        aria-controls="navbar-menu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="navbar-menu">
                    <ul class="navbar-nav">
                        <li class="nav-item @ViewData["home"]">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-home"></i>
                                </span>
                                <span class="nav-link-title"> کور پاڼه </span>
                            </a>
                        </li>

                        <li class="nav-item dropdown @ViewData["account-tab"]">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-person"></i>
                                </span>
                                حسابونه
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item @ViewData["accountindex"]" asp-controller="Account" asp-action="Index">
                                        <i class="fa-solid fa-people-group"></i>
                                        اشخاص
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["accountaccounts"]" asp-controller="Account" asp-action="Accounts">
                                        <i class="fa-solid fa-wallet"></i>
                                        حسابونه
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["accountcontributors"]" asp-controller="Account" asp-action="Contributors">
                                        <i class="fa-solid fa-people-group"></i>
                                        شریکان
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown @ViewData["Inventory"]">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-warehouse"></i>
                                </span>
                                ګدام داري
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item @ViewData["Items"]" asp-controller="Inventory" asp-action="Index">
                                        <i class="fa-solid fa-box"></i>
                                        اجناس
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["Stocks"]" asp-controller="Inventory" asp-action="Stocks">
                                        <i class="fa-solid fa-boxes-stacked"></i>
                                        ګدامونه
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["StockHistory"]" asp-controller="Inventory" asp-action="StockHistory">
                                        <i class="fa-solid fa-receipt"></i>
                                        د ګدام تاریخچه
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["StockItems"]" asp-controller="Inventory" asp-action="StockItems">
                                        <i class="fa-solid fa-receipt"></i>
                                        د اجناسو موجودي
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item @ViewData["MinItems"]" asp-controller="Inventory" asp-action="MinAlerts">
                                        <i class="fa-solid fa-bell"></i>
                                        د کمښته خبرتیا
                                    </a>
                                </li>
                            </ul>

                        </li>

                        <li class="nav-item dropdown  @ViewData["Accounting"]">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-book"></i>
                                </span>
                                مالي چاري
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item @ViewData["SettingsIndex"]" asp-controller="Accounting" asp-action="Index">
                                        <i class="fa-solid fa-dollar"></i>
                                        اسعار
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @ViewData["Transactions"]" asp-controller="Accounting" asp-action="Transactions">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                        نقدي معاملات
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-tag"></i>
                                        د اجناسو قیمتونه
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </span>
                                خرید
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-cart-plus"></i>
                                        نوی خرید
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                        خرید لیست
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-file-circle-plus"></i>
                                        نوی خرید آرډر
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-file-lines"></i>
                                        خرید آرډر لیست
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </span>
                                فروش
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-cart-shopping"></i>
                                        نوی فروش
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                        فروش لیست
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-file-invoice-dollar"></i>
                                        نوی فروش آرډر
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-file-lines"></i>
                                        فروش آرډر لیست
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <li class="nav-item dropdown @ViewData["settings"]">
                            <a class="nav-link dropdown-toggle"
                               id="navbarDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <span class="nav-link-icon">
                                    <i class="fa-solid fa-gear"></i>
                                </span>
                                تنظیمات
                            </a>

                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item">
                                        <i class="fa-solid fa-gear"></i>
                                        تنظیمات
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @ViewData["ProfileSettings"]">
                                        <i class="fa-solid fa-user"></i>
                                        پروفایل
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @ViewData["UsersSettings"]">
                                        <i class="fa-solid fa-users"></i>
                                        یوزرونه
                                    </a>
                                </li>

                            </ul>

                        </li>


                    </ul>

                </div>
                <div class="navbar-nav flex-row order-md-last ms-auto">
                    <div class="nav-item dropdown">
                        <a href="#"
                           class="nav-link d-flex lh-1 text-reset"
                           data-bs-toggle="dropdown"
                           aria-label="Open user menu">
                            <span class="avatar avatar-sm"></span>
                            <div class="d-none d-xl-block ps-2">
                                <div id="userInfo"></div>
                                <div class="mt-1 small text-secondary" id="userRoles"></div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <a class="dropdown-item">
                                <i class="fa-solid fa-user"></i>
                                پروفایل
                            </a>
                            <a class="dropdown-item">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                تاریخچه
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item">
                                <i class="fa-solid fa-gears"></i>
                                تنظیمات
                            </a>
                            <button id="theme-toggle" type="button" class="dropdown-item">
                                <i class="fa-solid fa-moon"></i>
                            </button>
                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                <i class="fa-solid fa-right-from-bracket"></i> وتل
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </header>
    <div class="page-wrapper">
        <div class="page-body">
            <div class="container-xl">
                @RenderBody()
            </div>
        </div>
    </div>
    </main>
    <form id="logoutForm" method="post" action="@Url.Action("Logout", "Auth")" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-status bg-danger"></div>
                <div class="modal-body text-center py-4">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="icon mb-2 text-danger icon-lg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 9v2m0 4v.01" />
                        <path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" />
                    </svg>
                    <h3>مطمئن یاست؟</h3>
                    <div class="text-secondary">
                        غواړئ له سیسټم څخه ووځئ؟
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" id="logoutYesButton" class="btn btn-danger w-100"> تائید </a>
                            </div>
                            <div class="col">
                                <a href="#"  class="btn w-100" data-bs-dismiss="modal"> لغوه </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/tabler/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>

        $.ajax({
            url: "/api/Users/GetCurrencyUser",
            type: "GET",
            success: function(data){
                $("#userInfo").text(data.firstName + " " + data.lastName);
            },
            error: function(response){
                console.log(response);
            }
        });

        $.ajax({
            url: "/api/Users/GetCurrenctUserRoles",
            type: "GET",
            success: function(data){
                $("#userRoles").text(data);
            },
            error: function(response){
                console.log(response);
            }
        });

        document.getElementById("logoutYesButton").onclick = function(){
            var logoutform = document.getElementById("logoutForm");
            logoutform.submit();
        }

        const html = document.documentElement;

        // Load saved theme
        const savedTheme = localStorage.getItem("theme") || "light";
        html.setAttribute("data-bs-theme", savedTheme);

        var globalTheme = localStorage.getItem("theme");

        var toggleThemeButton = document.getElementById("theme-toggle");

        toggleThemeButton.innerHTML = (savedTheme === "dark" ? "<i class='fa-solid fa-sun'></i> روښان شکل" : "<i class='fa-solid fa-moon'></i> تاریک شکل");

        toggleThemeButton.addEventListener("click", function () {

            const theme = html.getAttribute("data-bs-theme") === "dark"
            ? "light"
            : "dark";
            html.setAttribute("data-bs-theme", theme);
        toggleThemeButton.innerHTML = (theme === "dark" ? "<i class='fa-solid fa-sun'></i> روښان شکل" : "<i class='fa-solid fa-moon'></i> تاریک شکل");
            localStorage.setItem("theme", theme);
            globalTheme = localStorage.getItem("theme");
        });

         const Toast = Swal.mixin({
                            toast: true,
                            position: "top-end",
                            theme: globalTheme,
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            didOpen: (toast) => {
                                toast.onmouseenter = Swal.stopTimer;
                                toast.onmouseleave = Swal.resumeTimer;
                            }
                        });
        function showToast(icon, message) {
            Toast.fire({
                icon: icon,
                title: message,
                theme: globalTheme
            });
        }

        function sweetAlert(title, text){
            return Swal.fire({
                    title: title,
                    text: text,
                    theme: globalTheme,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "هو",
                    cancelButtonText: "نه"
                });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
