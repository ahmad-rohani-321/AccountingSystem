@{
    ViewData["title"] = "یوزرونه";
    ViewData["settings"] = "active";
    ViewData["UsersSettings"] = "active";
}

@section Styles {
    <link href="~/lib/tom-select/dist/css/tom-select.bootstrap5.css" rel="stylesheet" />
}

<div class="row row-deck row-cards">
    <div class="card">
        <div class="card-header">
            <h3 class="h3 mb-0">د سیسټم یوزرونه</h3>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <button class="btn btn-primary" id="createUserButton" type="button">
                    نوی یوزر
                    <i class="fas fa-plus ms-2"></i>
                </button>
            </div>
            <div class="row row-deck row-cards" id="usersList"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="createUserForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">نوی یوزر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newFirstName">نوم</label><input type="text" class="form-control" id="newFirstName" placeholder="نوم" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newLastName">تخلص</label><input type="text" class="form-control" id="newLastName" placeholder="تخلص" /></div></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newUserName">یوزر نوم</label><input type="text" dir="ltr" class="form-control" id="newUserName" placeholder="یوزر نوم" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newEmail">د یوزر ایمېل</label><input type="email" dir="ltr" class="form-control" id="newEmail" placeholder="د یوزر ایمېل" /></div></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newPassword">پټ نوم</label><input type="password" dir="ltr" class="form-control" id="newPassword" placeholder="پټ نوم" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="newRole">صلاحیت</label><select class="form-select" id="newRole"><option value="">صلاحیت انتخاب کړئ</option></select></div></div>
                </div>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" id="btnCreateUser" type="submit">ثبت <i class="fas fa-save ms-2"></i></button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">لغوه <i class="fas fa-times ms-2"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <form id="editUserForm" class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">د یوزر معلومات تغیر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserId" />
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editFirstName">نوم</label><input type="text" class="form-control" id="editFirstName" placeholder="نوم" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editLastName">تخلص</label><input type="text" class="form-control" id="editLastName" placeholder="تخلص" /></div></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editUserName">یوزر نوم</label><input type="text" dir="ltr" class="form-control" id="editUserName" placeholder="یوزر نوم" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editEmail">ایمېل</label><input type="email" dir="ltr" class="form-control" id="editEmail" placeholder="ایمېل" /></div></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editPhoneNumber">د اړیکې شمېره</label><input type="text" dir="ltr" class="form-control" id="editPhoneNumber" placeholder="د اړیکې شمېره" /></div></div>
                    <div class="col-md-6"><div class="mb-3"><label class="form-label" for="editRole">صلاحیت</label><select class="form-select" id="editRole"><option value="">صلاحیت انتخاب کړئ</option></select></div></div>
                </div>
            </div>
            <div class="modal-footer align-items-end">
                <button class="btn btn-primary" id="btnSaveUser" type="submit">ثبت <i class="fas fa-save ms-2"></i></button>
                <button class="btn btn-danger" type="reset" data-bs-dismiss="modal">لغوه <i class="fas fa-times ms-2"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="userHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content overflow-auto">
            <div class="modal-header">
                <h5 class="modal-title">د یوزر تاریخچه <span id="historyUserName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive"><table class="table table-bordered table-hover table-striped"><thead><tr><th>برخه</th><th>تفصیل</th><th>نېټه</th></tr></thead><tbody id="userHistoryList"></tbody></table></div>
            </div>
            <div class="modal-footer align-items-end"><button class="btn btn-danger" type="button" data-bs-dismiss="modal">لغوه <i class="fas fa-times ms-2"></i></button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
    <script src="~/lib/moment-jalali/dist/jalali-moment.browser.js"></script>
    <script src="~/lib/tom-select/dist/js/tom-select.complete.min.js"></script>
    <script>
        var newRoleSelect = new TomSelect("#newRole", { create: false, allowEmptyOption: true, controlInput: null });
        var editRoleSelect = new TomSelect("#editRole", { create: false, allowEmptyOption: true, controlInput: null });

        $(document).ready(function() {
            loadRoles();
            loadUsers();
        });

        function loadRoles() {
            $.ajax({
                url: "/api/Users/GetRoles",
                type: "GET",
                success: function(data) {
                    data.forEach(function(role) {
                        var option = { value: role.name, text: role.pashtoName };
                        newRoleSelect.addOption(option);
                        editRoleSelect.addOption(option);
                    });
                    newRoleSelect.refreshOptions(false);
                    editRoleSelect.refreshOptions(false);
                },
                error: function(response) { showToast("warning", response.responseText || "صلاحیتونه ترلاسه نه سول."); }
            });
        }

        function loadUsers() {
            $.ajax({
                url: "/api/Users/GetUsers",
                type: "GET",
                success: function(data) {
                    var usersList = $("#usersList");
                    usersList.empty();
                    if (!data.length) {
                        $("<div>").addClass("col-12 text-center text-muted py-4").text("هیڅ یوزر ونه موندل سو.").appendTo(usersList);
                        return;
                    }
                    data.forEach(function(user) {
                        var column = $("<div>").addClass("col-12 col-sm-6 col-xl-3");
                        var card = $("<div>").addClass("card h-100").appendTo(column);
                        var body = $("<div>").addClass("card-body text-center py-4").appendTo(card);
                        var photo = $("<span>").addClass("avatar avatar-xl rounded-circle mb-3").appendTo(body);
                        if (user.profilePhoto) {
                            photo.css("background-image", "url('/Profiles/" + encodeURIComponent(user.profilePhoto) + "')");
                        }
                        else {
                            photo.text((user.firstName || user.userName || "").charAt(0));
                        }
                        $("<h3>").addClass("h3 mb-1 text-break").text(user.firstName + " " + user.lastName).appendTo(body);
                        $("<div>").addClass("text-muted mb-3 text-break").attr("dir", "ltr").text(user.userName).appendTo(body);
                        $("<div>").addClass("text-muted mb-2").text(user.role).appendTo(body);
                        $("<span>").addClass(user.isActive ? "badge bg-success-lt" : "badge bg-danger-lt").text(user.isActive ? "فعال" : "غیر فعال").appendTo(body);
                        var actions = $("<div>").addClass("d-flex flex-wrap justify-content-center gap-2 mt-3").appendTo(body);
                        $("<button>").attr("type", "button").text("تغیر").addClass("btn btn-sm btn-primary btn-edit-user").attr("data-user", JSON.stringify(user)).appendTo(actions);
                        $("<button>").attr("type", "button").text("تاریخچه").addClass("btn btn-sm btn-info btn-user-history").attr("data-info", JSON.stringify({ id: user.id, name: user.firstName + " " + user.lastName })).appendTo(actions);
                        $("<button>").attr("type", "button").text(user.isActive ? "غیر فعال" : "فعال").addClass(user.isActive ? "btn btn-sm btn-danger btn-toggle-user" : "btn btn-sm btn-success btn-toggle-user").attr("data-id", user.id).appendTo(actions);
                        var footer = $("<div>").addClass("card-footer p-0 mt-auto").appendTo(card);
                        var contacts = $("<div>").addClass("d-flex").appendTo(footer);
                        var email = $("<a>").addClass("d-flex align-items-center justify-content-center gap-2 w-50 py-3 text-reset border-end").append($("<i>").addClass("far fa-envelope text-muted"), $("<span>").text("ایمېل")).appendTo(contacts);
                        if (user.email) {
                            email.attr("href", "mailto:" + user.email).attr("title", user.email);
                        }
                        else {
                            email.addClass("text-muted").attr("aria-disabled", "true");
                        }
                        var phone = $("<a>").addClass("d-flex align-items-center justify-content-center gap-2 w-50 py-3 text-reset").append($("<i>").addClass("fas fa-phone text-muted"), $("<span>").text("اړیکه")).appendTo(contacts);
                        if (user.phoneNumber) {
                            phone.attr("href", "tel:" + user.phoneNumber).attr("title", user.phoneNumber);
                        }
                        else {
                            phone.addClass("text-muted").attr("aria-disabled", "true");
                        }
                        usersList.append(column);
                    });
                },
                error: function(response) { showToast("warning", response.responseText || "د یوزرونو معلومات ترلاسه نه سول."); }
            });
        }

        $("#createUserButton").on("click", function() {
            $("#createUserForm")[0].reset();
            newRoleSelect.clear();
            createUserFormValidator.refresh();
            $("#createUserModal").modal("show");
        });

        var createUserFormValidator = new JustValidate("#createUserForm");
        createUserFormValidator
        .addField("#newFirstName", [{ rule: "required", errorMessage: "نوم اړین دی" }])
        .addField("#newLastName", [{ rule: "required", errorMessage: "تخلص اړین دی" }])
        .addField("#newUserName", [{ rule: "required", errorMessage: "یوزر نوم اړین دی" }])
        .addField("#newEmail", [{ rule: "required", errorMessage: "ایمېل اړین دی" }, { rule: "email", errorMessage: "صحیح ایمېل ولیکئ" }])
        .addField("#newPassword", [{ rule: "required", errorMessage: "پټ نوم اړین دی" }, { rule: "password", errorMessage: "پټ نوم لږ تر لږه ۸ توري او یو عدد ولري" }])
        .addField("#newRole", [{ rule: "required", errorMessage: "صلاحیت انتخاب کړئ" }]);
        createUserFormValidator.onSuccess(function(event) {
            event.preventDefault();
            checkUserDuplicate($("#newUserName").val(), $("#newFirstName").val(), "", function() {
                var submitButton = $("#btnCreateUser").prop("disabled", true);
                $.ajax({
                    url: "/api/Users/CreateUser",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ firstName: $("#newFirstName").val(), lastName: $("#newLastName").val(), userName: $("#newUserName").val(), email: $("#newEmail").val(), password: $("#newPassword").val(), role: newRoleSelect.getValue() }),
                    success: function() { $("#createUserModal").modal("hide"); showToast("success", "نوی یوزر په بریالیتوب سره جوړ سو."); loadUsers(); },
                    error: function(response) { showToast("warning", response.responseText || "نوی یوزر جوړ نه سو."); },
                    complete: function() { submitButton.prop("disabled", false); }
                });
            });
        });

        $(document).on("click", ".btn-edit-user", function() {
            var user = $(this).data("user");
            $("#editUserId").val(user.id);
            $("#editFirstName").val(user.firstName);
            $("#editLastName").val(user.lastName);
            $("#editUserName").val(user.userName);
            $("#editEmail").val(user.email);
            $("#editPhoneNumber").val(user.phoneNumber);
            editRoleSelect.setValue(user.role);
            $("#editUserModal").modal("show");
        });

        $(document).on("click", ".btn-user-history", function() {
            var info = $(this).data("info");
            $("#historyUserName").text(info.name);
            var table = $("#userHistoryList");
            var historyTable = table.closest("table");
            destroyListingDataTable(historyTable);
            table.empty();
            $.ajax({
                url: "/api/Users/GetUserHistory/" + info.id,
                type: "GET",
                success: function(data) {
                    data.forEach(function(history) {
                        var row = $("<tr>");
                        $("<td>").text(history.modelName).appendTo(row);
                        $("<td>").text(history.details).appendTo(row);
                        $("<td>").text(moment(history.creationDate).format("jYYYY/jMM/jDD HH:mm:ss")).appendTo(row);
                        table.append(row);
                    });
                    initializeListingDataTable(historyTable);
                    $("#userHistoryModal").one("shown.bs.modal", function() {
                        historyTable.DataTable().columns.adjust();
                    });
                    $("#userHistoryModal").modal("show");
                },
                error: function(response) { showToast("warning", response.responseText || "د تاریخچې معلومات ترلاسه نه سول."); }
            });
        });

        var editUserFormValidator = new JustValidate("#editUserForm");
        editUserFormValidator
        .addField("#editFirstName", [{ rule: "required", errorMessage: "نوم اړین دی" }])
        .addField("#editLastName", [{ rule: "required", errorMessage: "تخلص اړین دی" }])
        .addField("#editUserName", [{ rule: "required", errorMessage: "یوزر نوم اړین دی" }])
        .addField("#editEmail", [{ rule: "required", errorMessage: "ایمېل اړین دی" }, { rule: "email", errorMessage: "صحیح ایمېل ولیکئ" }])
        .addField("#editRole", [{ rule: "required", errorMessage: "صلاحیت انتخاب کړئ" }]);
        editUserFormValidator.onSuccess(function(event) {
            event.preventDefault();
            checkUserDuplicate($("#editUserName").val(), $("#editFirstName").val(), $("#editUserId").val(), function() {
                var submitButton = $("#btnSaveUser").prop("disabled", true);
                $.ajax({
                    url: "/api/Users/UpdateUser",
                    type: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify({ id: $("#editUserId").val(), firstName: $("#editFirstName").val(), lastName: $("#editLastName").val(), userName: $("#editUserName").val(), email: $("#editEmail").val(), phoneNumber: $("#editPhoneNumber").val(), role: editRoleSelect.getValue() }),
                    success: function() { $("#editUserModal").modal("hide"); showToast("success", "د یوزر معلومات په بریالیتوب سره تغیر سول."); loadUsers(); },
                    error: function(response) { showToast("warning", response.responseText || "د یوزر معلومات تغیر نه سول."); },
                    complete: function() { submitButton.prop("disabled", false); }
                });
            });
        });

        function checkUserDuplicate(userName, firstName, id, success) {
            $.ajax({
                url: "/api/Users/CheckDuplicate",
                type: "GET",
                data: { userName: userName, firstName: firstName, id: id },
                success: function(data) {
                    if (data.userNameExists) {
                        showToast("warning", "دغه یوزر نوم مخکې موجود دی.");
                    }
                    else if (data.firstNameExists) {
                        showToast("warning", "دغه نوم مخکې موجود دی.");
                    }
                    else {
                        success();
                    }
                },
                error: function(response) {
                    showToast("warning", response.responseText || "د تکراري معلوماتو په ترلاسه کولو کې ستونزه رامنځته سوه.");
                }
            });
        }

        $(document).on("click", ".btn-toggle-user", function() {
            var id = $(this).data("id");
            sweetAlert("تاسو اطمناني یاست؟", "غواړئ د انتخاب سوي یوزر فعالیت تغیر کړئ؟").then(function(result) {
                if (!result.isConfirmed) return;
                $.ajax({
                    url: "/api/Users/UpdateUserActivation/" + id,
                    type: "PUT",
                    success: function() { showToast("success", "د یوزر فعالیت تغیر سو."); loadUsers(); },
                    error: function(response) { showToast("warning", response.responseText || "د یوزر فعالیت تغیر نه سو."); }
                });
            });
        });
    </script>
}
